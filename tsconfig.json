{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "almostnode": ["./packages/almostnode/index.ts"],
      "@brianjenkins94/tsval": ["./packages/tsval/src/index.ts"],
      "@brianjenkins94/tsval/typed": ["./packages/tsval/src/typed.ts"],
      "@brianjenkins94/bablr": ["./packages/bablr/src/index.js"],
      "@brianjenkins94/monaco-vscode-api/main": ["./components/monaco-vscode-api/main.ts"],
      "@brianjenkins94/bablr-language-ts": ["./packages/bablr-language-ts/lib/grammar.ts"],
      "@brianjenkins94/bablr-language-ts/spans": ["./packages/bablr-language-ts/lib/spans.ts"],
      "@components/*": ["./components/*"]
    },
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "resolveJsonModule": true,
    "strict": false,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "target": "ESNext"
  },
  "exclude": ["node_modules"]
}
