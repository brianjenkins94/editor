{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    "customConditions": ["source"],
    // A pre-built package ships only dist, so its manifest can't name source: types come from here, and its exports stay what's published.
    "paths": {
      "@brianjenkins94/monaco-vscode-api/main": ["./components/monaco-vscode-api/main.ts"]
    },
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "resolveJsonModule": true,
    "strict": false,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "target": "ESNext"
  },
  "exclude": ["node_modules", "packages/tsval/vendor"]
}
