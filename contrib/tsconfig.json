{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "compilerOptions": {
    // JavaScript is as welcome as TypeScript: a .js file is bundled the same, and not type-checked.
    "allowJs": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": false,
    "isolatedModules": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ESNext",
    "types": ["vscode"]
  },
  "exclude": ["node_modules", "dist"]
}
