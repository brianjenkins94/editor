// The editor's API Worker (README.md). Secrets are never in this file: `wrangler secret put` (SIGNING_JWK, NONCE_KEY,
// TOKEN_KEK, AUDIT_KEY, STATE_KEY, GITHUB_CLIENT_SECRET; README.md's A0 says how to make each; and ANALYTICS_TOKEN,
// Cloudflare's read-only analytics, packages/admin/README.md B4; CODE_KEY, 32 random bytes, emailed codes' HMAC key,
// SIGN-IN.md C2; TOTP_KEK, 32 random bytes, what authenticator-app secrets are sealed under, C5; ALERT_EMAIL, the owner's address,
// where the kill switch emails, OPERATIONS.md O1). ANALYTICS_ACCOUNT and ANALYTICS_ZONE (unusuallygood.dev) are ids, not secrets. `send_email` is Cloudflare
// Email Service, from no-reply@unusuallygood.dev only (the zone is onboarded for Email Sending).
// The top level is local `wrangler dev` and the tests; `--env dev` and `--env production` are the deployments.
// vars, bindings and observability are repeated per environment on purpose: wrangler doesn't inherit them, and each
// deployment's settings should be readable where it's declared. Production's D1 id is a placeholder until A7 creates
// its database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Cloudflare's own invocation logs record each request's URL, and the docs don't say what else; with no way to
  // redact them, they're off, and the Worker writes its own request line from an allowlist (src/log.ts).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true }
  },
  // Daily at 03:17 UTC: retention, purges, the smoke test (src/index.ts, scheduled). Hourly at :07: the cost guard
  // (src/spend.ts, OPERATIONS.md O2). Every environment inherits them.
  "triggers": { "crons": ["17 3 * * *", "7 * * * *"] },
  // One Grant per sign-in (src/grant.ts), on SQLite storage.
  // One Attempt per sign-in in progress (src/attempt.ts), on SQLite storage too.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Grant"] }, { "tag": "v2", "new_sqlite_classes": ["Attempt"] }],
  "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }, { "name": "ATTEMPTS", "class_name": "Attempt" }] },
  // The sign-in page (public/sign-in.html, SIGN-IN.md), served beside the Worker; everything else is the Worker's.
  "assets": { "directory": "public" },
  "d1_databases": [{ "binding": "DB", "database_name": "editor-api-local", "database_id": "local", "migrations_dir": "migrations" }],
  // The audit log's write-once copies (src/audit-copies.ts). The deployed buckets have lock rules (`routine/` 90 days,
  // `suspicious/` 365) and expiry rules a day after, made with `wrangler r2 bucket lock add` / `lifecycle add` (README.md).
  "r2_buckets": [{ "binding": "AUDIT_COPIES", "bucket_name": "editor-api-audit-local" }],
  // Rate limits (src/limits.ts), a minute each: sign-in by IP, the token endpoint by IP and by the grant a token names,
  // the proxy by user, and one alert a minute per event and subject. namespace_id is account-wide and shared by every
  // binding that names it, so each environment has its own range (90xx here, never deployed; 10xx dev; 20xx production).
  "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "9001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "9002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "9003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "9004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "9005", "simple": { "limit": 1, "period": 60 } }],
  // GITHUB_CLIENT_ID isn't secret (its secret is GITHUB_CLIENT_SECRET): local `wrangler dev` uses the dev GitHub App too,
  // through its localhost callback.
  // Our OAuth clients (each app's name, sign-in methods and pages, and so the origins allowed) are src/clients.ts.
  // OWNERS are GitHub user ids (src/rbac.ts): brianjenkins94.
  "vars": { "ENVIRONMENT": "local", "TRIPWIRE": "enforce", "INBOX": "smoke-test@unusuallygood.dev", "OWNERS": [9398474], "VIEWERS": [64174526], "ANALYTICS_ACCOUNT": "3ade13ae64e29b20e6b7c61f9ae7b714", "ANALYTICS_ZONE": "54d20cd60d5353f2080a1c8aec6def0d", "GITHUB_CLIENT_ID": "Iv23ligdisoL7OPTVtXm" },
  "env": {
    "dev": {
      "name": "editor-api-dev",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": true }
      },
      "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }, { "name": "ATTEMPTS", "class_name": "Attempt" }] },
      "assets": { "directory": "public" },
      "d1_databases": [{ "binding": "DB", "database_name": "editor-api-dev", "database_id": "296ad75a-302e-4aa6-97cd-360f3481617e", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "AUDIT_COPIES", "bucket_name": "editor-api-audit-dev" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@unusuallygood.dev"] }],
      "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "1005", "simple": { "limit": 1, "period": 60 } }],
      "vars": { "ENVIRONMENT": "dev", "TRIPWIRE": "by-date", "INBOX": "smoke-test-dev@unusuallygood.dev", "OWNERS": [9398474], "VIEWERS": [64174526], "ANALYTICS_ACCOUNT": "3ade13ae64e29b20e6b7c61f9ae7b714", "ANALYTICS_ZONE": "54d20cd60d5353f2080a1c8aec6def0d", "GITHUB_CLIENT_ID": "Iv23ligdisoL7OPTVtXm" }
    },
    // api.unusuallygood.dev (README.md, A7), deployed by .github/workflows/production.yml with your approval. No workers.dev
    // URL: the custom domain is its only address. GitHub App `unusually-good-editor` (App ID 5339846).
    "production": {
      "name": "editor-api",
      "workers_dev": false,
      "routes": [{ "pattern": "api.unusuallygood.dev", "custom_domain": true }],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": true }
      },
      "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }, { "name": "ATTEMPTS", "class_name": "Attempt" }] },
      "assets": { "directory": "public" },
      "d1_databases": [{ "binding": "DB", "database_name": "editor-api", "database_id": "a81ff6d8-f4af-4b21-bbee-265203df0a72", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "AUDIT_COPIES", "bucket_name": "editor-api-audit" }],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["no-reply@unusuallygood.dev"] }],
      "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "2005", "simple": { "limit": 1, "period": 60 } }],
      "vars": { "ENVIRONMENT": "production", "TRIPWIRE": "by-date", "INBOX": "smoke-test@unusuallygood.dev", "OWNERS": [9398474], "VIEWERS": [64174526], "ANALYTICS_ACCOUNT": "3ade13ae64e29b20e6b7c61f9ae7b714", "ANALYTICS_ZONE": "54d20cd60d5353f2080a1c8aec6def0d", "GITHUB_CLIENT_ID": "Iv23liFJepSEiExenSOI" }
    }
  }
}
