// The editor's API Worker (README.md). Secrets are never in this file: `wrangler secret put` (SIGNING_JWK, NONCE_KEY,
// TOKEN_KEK, AUDIT_KEY, STATE_KEY, GITHUB_CLIENT_SECRET; README.md's A0 says how to make each).
// The top level is local `wrangler dev` and the tests; `--env dev` and `--env production` are the deployments.
// vars, bindings and observability are repeated per environment on purpose: wrangler doesn't inherit them, and each
// deployment's settings should be readable where it's declared. Production's D1 id is a placeholder until A7 creates
// its database.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "editor-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Cloudflare's own invocation logs record each request's URL, and the docs don't say what else; with no way to
  // redact them, they're off, and the Worker writes its own request line from an allowlist (src/log.ts).
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true }
  },
  // Daily at 03:17 UTC: the audit log's retention (src/audit.ts, expire). Every environment inherits it.
  "triggers": { "crons": ["17 3 * * *"] },
  // One Grant per sign-in (src/grant.ts), on SQLite storage.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Grant"] }],
  "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }] },
  "d1_databases": [{ "binding": "DB", "database_name": "editor-api-local", "database_id": "local", "migrations_dir": "migrations" }],
  // Rate limits (src/limits.ts), a minute each: sign-in by IP, the token endpoint by IP and by the grant a token names,
  // the proxy by user, and one alert a minute per event and subject. namespace_id is account-wide and shared by every
  // binding that names it, so each environment has its own range (90xx here, never deployed; 10xx dev; 20xx production).
  "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "9001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "9002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "9003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "9004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "9005", "simple": { "limit": 1, "period": 60 } }],
  // GITHUB_CLIENT_ID isn't secret (its secret is GITHUB_CLIENT_SECRET): local `wrangler dev` uses the dev GitHub App too,
  // through its localhost callback.
  "vars": { "ENVIRONMENT": "local", "ALLOWED_ORIGINS": "http://localhost:5173,http://editor.localhost:5173", "REDIRECT_URIS": "http://localhost:5173/,http://editor.localhost:5173/", "GITHUB_CLIENT_ID": "Iv23ligdisoL7OPTVtXm" },
  "env": {
    "dev": {
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": true }
      },
      "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "editor-api-dev", "database_id": "296ad75a-302e-4aa6-97cd-360f3481617e", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "1005", "simple": { "limit": 1, "period": 60 } }],
      "vars": { "ENVIRONMENT": "dev", "ALLOWED_ORIGINS": "https://brianjenkins94.github.io,http://localhost:5173,http://editor.localhost:5173", "REDIRECT_URIS": "https://brianjenkins94.github.io/editor/,http://localhost:5173/,http://editor.localhost:5173/", "GITHUB_CLIENT_ID": "Iv23ligdisoL7OPTVtXm" }
    },
    // Not deployed until A7: no workers.dev URL, and its route (our own domain) arrives with the domain.
    "production": {
      "name": "editor-api",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "traces": { "enabled": true }
      },
      "durable_objects": { "bindings": [{ "name": "GRANTS", "class_name": "Grant" }] },
      "d1_databases": [{ "binding": "DB", "database_name": "editor-api", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
      "ratelimits": [{ "name": "SIGN_IN_BY_IP", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } }, { "name": "TOKEN_BY_IP", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } }, { "name": "TOKEN_BY_GRANT", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } }, { "name": "PROXY_BY_USER", "namespace_id": "2004", "simple": { "limit": 300, "period": 60 } }, { "name": "ALERTS", "namespace_id": "2005", "simple": { "limit": 1, "period": 60 } }],
      "vars": { "ENVIRONMENT": "production", "ALLOWED_ORIGINS": "", "REDIRECT_URIS": "" }
    }
  }
}
