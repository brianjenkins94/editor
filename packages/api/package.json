{
  "name": "@brianjenkins94/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@noble/hashes": "latest",
    "@simplewebauthn/server": "latest",
    "hono": "latest",
    "jose": "latest"
  },
  "devDependencies": {
    "@awesome.me/webawesome": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "esbuild": "latest",
    "wrangler": "latest"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "test": "node --test --test-force-exit \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "audit": "node scripts/audit.ts",
    "maintenance": "node scripts/maintenance.ts",
    "harness": "node harness/harness.ts"
  }
}
