# The sign-in page (README.md, "Sign-in methods"): where credentials will be typed, so nothing runs here but our own files and Cloudflare's
# Web Analytics beacon (injected by Cloudflare, which serves this page anyway; it reports to /cdn-cgi/rum or
# cloudflareinsights.com). No framing, no referrer, nothing cached. connect-src allows data: for Web Awesome's own icons
# (the checkbox's check is a data: SVG it fetches): a data: URL reaches no server.
/sign-in*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; connect-src 'self' data: https://cloudflareinsights.com; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-store

# Adding a passkey (src/passkeys.ts): the same page rules, being where a passkey is made.
/passkey*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; connect-src 'self' https://cloudflareinsights.com; img-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-store
