{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": [
			"ES2023",
			"DOM",
			"DOM.Iterable"
		],
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"types": []
	},
	"include": [
		"src",
		"test"
	],
	"exclude": [
		"node_modules"
	]
}
