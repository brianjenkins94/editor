{
  "name": "@brianjenkins94/almostnode",
  "version": "0.0.0",
  "description": "Vendored, trimmed fork of macaly/almostnode@0.2.14 — the same-origin, main-thread in-browser node runtime only (used to run bundled node language servers in the editor).",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./async-context": "./shims/async_hooks.ts",
    "./bridge": "./server-bridge.ts",
    "./packages": "./frameworks/packages.ts",
    "./fs-capabilities": "./shims/fs-capabilities.ts",
    "./unenv-resolve": "./unenv-resolve.ts"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-force-exit \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pkgjs/parseargs": "latest",
    "assert": "latest",
    "events": "latest",
    "node-inspect-extracted": "latest",
    "pako": "latest",
    "path-browserify": "latest",
    "readable-stream": "latest",
    "resolve.exports": "latest",
    "string_decoder": "latest",
    "typescript": "^6",
    "unenv": "rc"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pako": "latest",
    "typescript": "^6"
  }
}
