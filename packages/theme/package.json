{
  "name": "theme",
  "version": "0.0.0",
  "description": "The app's theme: (theme, and theme/chrome without Web Awesome's native styles) Web Awesome set up with its --wa-* design tokens retoned for the brand, following the system's light/dark mode, (theme/vscode) mapped onto the active VS Code color theme in the workbench document, (theme/components/*) the Web Awesome components the app may use, the only way in to them, and (theme/exceptions/*) the custom CSS that's left, each file a named exception (PLAN.md).",
  "type": "module",
  "scripts": {
    "test": "node --test test/budget.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./chrome": "./src/chrome.js",
    "./theme.css": "./src/theme.css",
    "./vscode": {
      "types": "./src/vscode.d.ts",
      "default": "./src/vscode.js"
    },
    "./vscode.css": "./src/vscode.css",
    "./vscode-colors": {
      "types": "./src/vscode-colors.d.ts",
      "default": "./src/vscode-colors.js"
    },
    "./stitches": "./src/stitches.ts",
    "./sheet": {
      "types": "./src/sheet.d.ts",
      "default": "./src/sheet.js"
    },
    "./recipes": "./src/recipes.ts",
    "./styles/*": "./src/styles/*.ts",
    "./app-window": "./src/app-window.ts",
    "./documents": {
      "types": "./src/documents.d.ts",
      "default": "./src/documents.js"
    },
    "./components/*": {
      "types": "./src/components/*.d.ts",
      "default": "./src/components/*.js"
    },
    "./exceptions/*": "./src/exceptions/*"
  },
  "files": [
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@stitches/core": "1.2.8"
  },
  "peerDependencies": {
    "@awesome.me/webawesome": ">=3"
  },
  "devDependencies": {
    "@eslint/css-tree": "^4.1.1",
    "typescript": "^5.9.3"
  }
}
