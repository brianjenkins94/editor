{
  "name": "@brianjenkins94/debug-mcp",
  "version": "0.0.0",
  "description": "A Node hub-tree node that collects the span/log stream a page's composable hubs federate out over a WebSocket, and serves it to an agent over MCP — query_logs / query_spans / get_tree_state / wait_for — so the live editor's rendered and errored state is queryable without screenshots.",
  "type": "module",
  "bin": {
    "debug-mcp": "./bin.js"
  },
  "exports": {
    ".": "./src/server.ts",
    "./store": "./src/store.ts",
    "./mcp": "./src/mcp.ts",
    "./bin": "./src/bin.ts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@brianjenkins94/hub": "*",
    "@brianjenkins94/util": "*"
  },
  "devDependencies": {
    "@brianjenkins94/hub": "https://brianjenkins94.github.io/editor/packages/hub@latest.tgz",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13"
  }
}
