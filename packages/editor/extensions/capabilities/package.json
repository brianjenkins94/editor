{
  "name": "capabilities",
  "displayName": "Capabilities (tsserver plugin)",
  "description": "Surfaces a program's capability use (net/fs/exec/env/eval) — static detect/reach plus a tsval canary — as native diagnostics, via a TypeScript Server Plugin that reuses tsserver's own typescript (real Program + checker, no bundled copy).",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "capabilities-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "capabilities.calls",
          "name": "Capability calls"
        }
      ]
    },
    "commands": [
      { "command": "capabilities.allow", "title": "Allow", "category": "Capabilities", "icon": "$(pass)" },
      { "command": "capabilities.deny", "title": "Deny", "category": "Capabilities", "icon": "$(circle-slash)" },
      { "command": "capabilities.clear", "title": "Clear disposition", "category": "Capabilities", "icon": "$(discard)" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "capabilities.allow", "when": "false" },
        { "command": "capabilities.deny", "when": "false" },
        { "command": "capabilities.clear", "when": "false" }
      ],
      "view/item/context": [
        { "command": "capabilities.allow", "when": "view == capabilities.calls && viewItem == capabilityCall.resolved", "group": "inline@1" },
        { "command": "capabilities.deny", "when": "view == capabilities.calls && viewItem == capabilityCall.resolved", "group": "inline@2" },
        { "command": "capabilities.clear", "when": "view == capabilities.calls && viewItem == capabilityCall.resolved", "group": "capabilities@1" }
      ]
    }
  }
}
