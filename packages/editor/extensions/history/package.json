{
  "name": "history",
  "displayName": "History",
  "description": "The program as it stands, read as you edit by the TypeScript server's own TypeScript, and the feature ledger held to it: `silo check`'s drift in Problems, and what's been decided about a file or a name.",
  "publisher": "silo",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "files": ["node_modules/history-ts-plugin/package.json", "node_modules/history-ts-plugin/index.js"],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "history-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
