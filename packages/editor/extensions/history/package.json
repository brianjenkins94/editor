{
  "name": "history",
  "displayName": "History",
  "description": "What your edits change, and whether runs used it, in the History output. The program as it stands, read as you edit by the TypeScript server's own TypeScript, and the feature ledger held to it: `silo check`'s drift in Problems, what's been decided about a file or a name, and what a way in reaches.",
  "publisher": "silo",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "files": [
    "node_modules/history-ts-plugin/package.json",
    "node_modules/history-ts-plugin/index.js"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "history-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ],
    "commands": [
      {
        "command": "history.show",
        "title": "Show What Changed",
        "category": "History"
      },
      {
        "command": "history.reach.show",
        "title": "What a Way In Reaches…",
        "category": "History"
      }
    ]
  }
}
