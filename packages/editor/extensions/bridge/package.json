{
  "name": "bridge",
  "displayName": "Bridge",
  "description": "The bridge between the editor's core runtime and VS Code — the one extension that touches the hub: core's vscode API is its; every debugger's editor-api events and capability stops, and the workspace runtime it gives a debugger (tsval, or an interpreter plugged in).",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
    "onTaskType:run"
  ],
  "contributes": {
    "commands": [
      {
        "command": "editor.features.show",
        "title": "Show",
        "category": "Features and Tests"
      },
      {
        "command": "editor.fs.trace",
        "title": "Trace File Calls…",
        "category": "Editor"
      },
      {
        "command": "editor.git.openRef",
        "title": "Open a Commit Read-Only…",
        "category": "Git"
      },
      {
        "command": "editor.pane.toggleNative",
        "title": "Switch Between Beside the Code and Annotations",
        "category": "Pane"
      },
      {
        "command": "editor.bablr.check",
        "title": "Check Which Files Parse…",
        "category": "BABLR"
      },
      {
        "command": "editor.workspace.checkpoint",
        "title": "Save Checkpoint",
        "category": "Workspace"
      },
      {
        "command": "editor.workspace.restoreCheckpoint",
        "title": "Restore Checkpoint…",
        "category": "Workspace"
      }
    ],
    "taskDefinitions": [
      {
        "type": "run",
        "required": [
          "script",
          "folder"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "The package.json script."
          },
          "folder": {
            "type": "string",
            "description": "The folder its package.json is in."
          }
        }
      }
    ],
    "debuggers": [
      {
        "type": "preview",
        "label": "Preview",
        "hiddenWhen": "true"
      }
    ]
  }
}
