{
  "name": "bridge",
  "displayName": "Bridge",
  "description": "The bridge between the editor's core runtime and VS Code — the one extension that touches the hub: core's vscode API is its; every debugger's editor-api events and capability stops, and the workspace runtime it gives a debugger (tsval, or an interpreter plugged in).",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebug"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "editor-features",
          "title": "Features and Tests",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "editor-features": [
        {
          "id": "editor.features",
          "name": "Features and Tests"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "editor.features.refresh",
          "when": "view == editor.features",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "editor.features.run",
          "when": "view == editor.features && viewItem == runnable",
          "group": "inline"
        }
      ]
    },
    "commands": [
      {
        "command": "editor.features.refresh",
        "title": "Refresh",
        "category": "Features and Tests",
        "icon": "$(refresh)"
      },
      {
        "command": "editor.features.run",
        "title": "Run Its Tests",
        "category": "Features and Tests",
        "icon": "$(run)"
      },
      {
        "command": "editor.fs.trace",
        "title": "Trace File Calls…",
        "category": "Editor"
      },
      {
        "command": "editor.git.openRef",
        "title": "Open a Commit Read-Only…",
        "category": "Git"
      },
      {
        "command": "editor.pane.toggleNative",
        "title": "Switch Between Beside the Code and Annotations",
        "category": "Pane"
      },
      {
        "command": "editor.bablr.check",
        "title": "Check Which Files Parse…",
        "category": "BABLR"
      }
    ]
  }
}
