{
  "name": "editor",
  "description": "The editor, built: its site — unpack it on a static host (an extension added in extensions.json) to serve an editor of its own.",
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "directory": "../../docs"
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx dev.ts",
    "lint": "util-lint",
    "test": "node -e \"process.exit(require('fs').existsSync('../bablr/dist/index.js') ? 0 : 1)\" || npm --prefix ../bablr run build && node --import tsx --test --test-concurrency=4 test/*.test.mjs workbench/terminal/commands/*/*.test.mjs",
    "test:architecture": "npm run test:architecture:suites && npm run test:architecture:diagram && npm run test:architecture:performance",
    "test:architecture:suites": "node --test --test-concurrency=5 --test-global-setup=test/architecture-harness.mjs test/worker-realms.mjs test/architecture-smoke.mjs test/architecture-tour-previews.mjs test/architecture-tour-runs.mjs test/architecture-tour-capabilities.mjs test/architecture-app.mjs test/contrib.mjs test/pane-views.mjs",
    "test:architecture:diagram": "node --test test/architecture-diagram.mjs",
    "test:architecture:performance": "node --test --test-global-setup=test/architecture-harness.mjs test/performance.mjs",
    "postinstall": "node patches/apply.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@awesome.me/webawesome": "^3.12.0",
    "@brianjenkins94/almostnode": "file:../almostnode",
    "@brianjenkins94/bablr": "file:../bablr",
    "@brianjenkins94/editor-api": "file:../editor-api",
    "@brianjenkins94/hub": "file:../hub",
    "@brianjenkins94/observability": "file:../observability",
    "@brianjenkins94/tsval": "file:../tsval",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@pkgjs/parseargs": "0.11.0",
    "@rolldown/browser": "1.2.13",
    "@stitches/core": "latest",
    "@typescript-eslint/parser": "^8.70.0",
    "@zenfs/core": "2.7.6",
    "@zenfs/dom": "1.2.14",
    "account": "file:../account",
    "codehike": "^1.1.0",
    "cspell-lib": "^10.3.0",
    "diff": "^8.0.4",
    "dockview": "8.3.1",
    "dockview-core": "8.3.1",
    "eslint": "^10.10.0",
    "isomorphic-git": "^1.42.2",
    "just-bash": "^3.4.2",
    "lucide": "latest",
    "lz-string": "^1.5.0",
    "oauth4webapi": "^3.8.8",
    "preact": "latest",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "semver": "^7.8.5",
    "theme": "file:../theme",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "^7.8.0",
    "@types/vscode": "latest",
    "playwright": "^1.63.0",
    "tar-stream": "^3.2.2",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "unenv": "2.0.0-rc.24",
    "vite": "latest"
  },
  "exports": {
    ".": {
      "types": "./app/vscode.tsx",
      "default": "./app/vscode.tsx"
    },
    "./vite": {
      "types": "./build/vite.ts",
      "default": "./build/vite.ts"
    }
  }
}
