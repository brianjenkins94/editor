{
  "name": "editor",
  "description": "The editor, built: its site — unpack it on a static host (an extension added in extensions.json) to serve an editor of its own.",
  "version": "0.0.0",
  "type": "module",
  "publishConfig": {
    "directory": "../../docs"
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx dev.ts",
    "lint": "util-lint",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.mjs workbench/terminal/commands/*/*.test.mjs",
    "test:architecture": "npm run test:architecture:realms && npm run test:architecture:performance",
    "test:architecture:realms": "node --test --test-global-setup=test/architecture-harness.mjs test/worker-realms.mjs",
    "test:architecture:performance": "node --import tsx --test --test-global-setup=test/architecture-harness.mjs test/performance.mjs",
    "postinstall": "node patches/apply.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "latest",
    "@awesome.me/webawesome": "latest",
    "@brianjenkins94/almostnode": "file:../almostnode",
    "@brianjenkins94/editor-api": "file:../editor-api",
    "@brianjenkins94/hub": "file:../hub",
    "@brianjenkins94/observability": "file:../observability",
    "@brianjenkins94/playwright": "file:../playwright",
    "@brianjenkins94/tsval": "file:../tsval",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@pkgjs/parseargs": "latest",
    "@rolldown/browser": "latest",
    "@typescript-eslint/parser": "latest",
    "@zenfs/core": "2.8.3",
    "@zenfs/dom": "latest",
    "@zenfs/streams": "1.0.2",
    "account": "file:../account",
    "codehike": "latest",
    "cspell-lib": "latest",
    "diff": "latest",
    "dockview": "latest",
    "dockview-core": "latest",
    "eslint": "latest",
    "isomorphic-git": "latest",
    "just-bash": "latest",
    "lucide": "latest",
    "lz-string": "latest",
    "oauth4webapi": "latest",
    "preact": "latest",
    "react": "latest",
    "react-dom": "latest",
    "semver": "latest",
    "theme": "file:../theme",
    "vscode-languageclient": "latest",
    "vscode-languageserver": "latest",
    "vscode-languageserver-textdocument": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/semver": "latest",
    "@types/vscode": "latest",
    "playwright": "latest",
    "tar-stream": "latest",
    "tsx": "latest",
    "typescript": "^6",
    "unenv": "2.0.0-rc.24",
    "vite": "latest"
  },
  "exports": {
    ".": {
      "types": "./app/vscode.tsx",
      "default": "./app/vscode.tsx"
    },
    "./vite": {
      "types": "./build/vite.ts",
      "default": "./build/vite.ts"
    }
  }
}
