{
  "name": "eslint",
  "displayName": "ESLint (tsserver plugin)",
  "description": "Lints JS/TS via a TypeScript Server Plugin that reuses tsserver's own typescript — no bundled copy.",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "typescriptServerPlugins": [
      {
        "name": "eslint-ts-plugin",
        "enableForWorkspaceTypeScriptVersions": true
      }
    ]
  }
}
