{
  "name": "worker-pod",
  "displayName": "Worker Pod",
  "description": "One extension hosting a pod of workers: almostnode-backed language servers (cspell, eslint) and a tsval debug adapter.",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onDebug",
    "onDebugResolve:tsval"
  ],
  "contributes": {
    "commands": [
      { "command": "editor.debugFile", "title": "Run", "category": "Debug", "icon": "$(play)" },
      { "command": "tsval.exploreOrderings", "title": "Explore Orderings", "category": "Debug", "icon": "$(type-hierarchy)" },
      { "command": "tsval.stepRecordedStop", "title": "Step a Recorded Stop", "category": "Debug", "icon": "$(debug-step-into)" },
      { "command": "tsval.skipWaits", "title": "Skip Waits", "category": "Debug", "icon": "$(rocket)", "enablement": "debugType == tsval" },
      { "command": "tsval.waitRealTime", "title": "Wait in Real Time", "category": "Debug", "icon": "$(watch)", "enablement": "debugType == tsval" }
    ],
    "menus": {
      "debug/toolBar": [
        { "command": "tsval.skipWaits", "when": "debugType == tsval && !tsval.skipWaits", "group": "navigation@10" },
        { "command": "tsval.waitRealTime", "when": "debugType == tsval && tsval.skipWaits", "group": "navigation@10" }
      ],
      "editor/title/run": [
        { "command": "editor.debugFile", "when": "resourceExtname =~ /\\.(m|c)?[jt]sx?$/", "group": "navigation@2" }
      ],
      "editor/title": [
        { "command": "tsval.exploreOrderings", "when": "resourceExtname =~ /\\.(m|c)?[jt]sx?$/", "group": "1_run@1" }
      ]
    },
    "taskDefinitions": [
      {
        "type": "run",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "description": "The command to run, as typed in a terminal (npm run dev)." },
          "cwd": { "type": "string", "description": "Where to run it (the workspace, by default)." }
        }
      }
    ],
    "breakpoints": [
      { "language": "typescript" },
      { "language": "typescriptreact" },
      { "language": "javascript" },
      { "language": "javascriptreact" }
    ],
    "debuggers": [
      {
        "type": "tsval",
        "label": "Run",
        "languages": ["typescript", "typescriptreact", "javascript", "javascriptreact"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The source file to run under tsval.",
                "default": "${file}"
              },
              "args": { "type": "array", "items": { "type": "string" }, "description": "Its arguments: process.argv after the node and the file.", "default": [] }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "tsval",
            "request": "launch",
            "name": "Debug (tsval)",
            "program": "${file}"
          }
        ]
      },
      {
        "type": "production",
        "label": "production (almostnode run)",
        "hiddenWhen": "true"
      }
    ]
  }
}
