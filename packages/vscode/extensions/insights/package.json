{
  "name": "insights",
  "displayName": "Insights",
  "description": "What a program did when it ran, and what the editor is doing: statement coverage through VS Code's own test-coverage UI (from any debug session that reports it \u2014 the tsval debugger does), and a monitor of the metrics plane (memory by realm, workspace fill, long frames, hub traffic, storage) in the status bar and a view of sparkline cards.",
  "publisher": "brianjenkins94",
  "version": "0.0.1",
  "engines": {
    "vscode": "*"
  },
  "browser": "extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "insights.runFileWithCoverage",
        "title": "Run File with Coverage",
        "category": "Insights",
        "icon": "$(debug-coverage)"
      },
      {
        "command": "insights.showSessionCoverage",
        "title": "Show Coverage So Far",
        "category": "Insights",
        "icon": "$(debug-coverage)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "insights.runFileWithCoverage",
          "when": "resourceLangId =~ /^(type|java)script(react)?$/",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "insights.runFileWithCoverage",
          "when": "editorLangId =~ /^(type|java)script(react)?$/"
        },
        {
          "command": "insights.showSessionCoverage",
          "when": "inDebugMode"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "insights",
          "title": "Insights",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "insights": [
        {
          "type": "webview",
          "id": "insights.monitor",
          "name": "Monitor"
        }
      ]
    }
  }
}
