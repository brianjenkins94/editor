{
  "name": "vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build:entry": "vite build -c entry.config.ts",
    "build": "vite build -c entry.config.ts && vite build -c lsp.config.ts && vite build",
    "dev": "vite build -c entry.config.ts && vite build -c lsp.config.ts && vite",
    "lint": "util-lint"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@brianjenkins94/almostnode": "file:../almostnode",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@stitches/core": "latest",
    "@typescript-eslint/parser": "^8.70.0",
    "@zenfs/core": "^2.7.4",
    "cspell-lib": "^10.3.0",
    "eslint": "^10.10.0",
    "lucide": "latest",
    "preact": "latest",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/vscode": "latest",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "exports": {
    ".": {
      "types": "./vscode.tsx",
      "default": "./vscode.tsx"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    }
  }
}
