{
  "name": "vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build:entry": "vite build -c entry.config.ts",
    "build:engine": "vite build -c engine.plugin.config.ts",
    "build": "vite build -c entry.config.ts && vite build -c engine.plugin.config.ts && vite build",
    "dev": "vite build -c entry.config.ts && vite build -c engine.plugin.config.ts && vite",
    "lint": "util-lint"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@stitches/core": "latest",
    "lucide": "latest",
    "preact": "latest",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1"
  },
  "devDependencies": {
    "@oxc-parser/binding-wasm32-wasi": "0.149.0",
    "@types/node": "latest",
    "@types/vscode": "latest",
    "tsx": "latest",
    "vite": "latest"
  },
  "exports": {
    ".": {
      "types": "./vscode.tsx",
      "default": "./vscode.tsx"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    }
  }
}
