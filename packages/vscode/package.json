{
  "name": "vscode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx dev.ts",
    "lint": "util-lint",
    "test": "node -e \"process.exit(require('fs').existsSync('../bablr/dist/index.js') ? 0 : 1)\" || npm --prefix ../bablr run build && node --import tsx --test --test-concurrency=4 test/*.test.mjs",
    "test:architecture": "node --test --test-concurrency=1 test/architecture-smoke.mjs test/architecture-tour.mjs test/architecture-app.mjs test/performance.mjs",
    "postinstall": "node patches/apply.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "^3.5.0",
    "@awesome.me/webawesome": "^3.12.0",
    "@brianjenkins94/almostnode": "file:../almostnode",
    "@brianjenkins94/bablr": "file:../bablr",
    "@brianjenkins94/hub": "file:../hub",
    "@brianjenkins94/observability": "file:../observability",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@stitches/core": "latest",
    "@typescript-eslint/parser": "^8.70.0",
    "@zenfs/core": "2.7.6",
    "@zenfs/dom": "1.2.14",
    "codehike": "^1.1.0",
    "cspell-lib": "^10.3.0",
    "dockview": "8.3.1",
    "dockview-core": "8.3.1",
    "eslint": "^10.10.0",
    "isomorphic-git": "^1.42.2",
    "just-bash": "^3.4.2",
    "lucide": "latest",
    "lz-string": "^1.5.0",
    "oxc-parser": "0.151.0",
    "preact": "latest",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-reconciler": "0.29.0",
    "theme": "file:../theme",
    "vscode-languageclient": "^10.1.1",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@oxc-parser/binding-wasm32-wasi": "0.151.0",
    "@types/node": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "latest",
    "node-stdlib-browser": "^1.3.1",
    "playwright": "^1.63.0",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vite": "latest",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "exports": {
    ".": {
      "types": "./vscode.tsx",
      "default": "./vscode.tsx"
    },
    "./vite": {
      "types": "./vite.ts",
      "default": "./vite.ts"
    }
  }
}
