{
	"[javascript][javascriptreact][typescript][typescriptreact]": {
		"editor.codeActionsOnSave": {
			"source.fixAll.eslint": "explicit"
		},
		"editor.defaultFormatter": "dbaeumer.vscode-eslint",
		"editor.formatOnSave": true
	},
	"editor.formatOnSave": false,
	// The preset also lints these (antfu's yaml/jsonc/markdown configs); the extension only does so when told.
	"eslint.validate": [
		"javascript",
		"javascriptreact",
		"typescript",
		"typescriptreact",
		"yaml",
		"json",
		"jsonc",
		"markdown"
	],
	// FROM: https://github.com/antfu/eslint-config#ide-support-auto-fix-on-save — style rules stay fixable
	// on save but don't paint the editor red; the preset's `hushFixable` design assumes exactly this.
	"eslint.rules.customizations": [
		{ "rule": "style/*", "severity": "off", "fixable": true },
		{ "rule": "format/*", "severity": "off", "fixable": true },
		{ "rule": "*-indent", "severity": "off", "fixable": true },
		{ "rule": "*-spacing", "severity": "off", "fixable": true },
		{ "rule": "*-spaces", "severity": "off", "fixable": true },
		{ "rule": "*-order", "severity": "off", "fixable": true },
		{ "rule": "*-dangle", "severity": "off", "fixable": true },
		{ "rule": "*-newline", "severity": "off", "fixable": true },
		{ "rule": "*quotes", "severity": "off", "fixable": true },
		{ "rule": "*semi", "severity": "off", "fixable": true }
	],
	"eslint.workingDirectories": [{ "mode": "location" }],
	"files.insertFinalNewline": true,
	"files.trimTrailingWhitespace": true,
	"javascript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
	"javascript.format.insertSpaceBeforeFunctionParenthesis": false,
	// TypeScript's own web type acquisition installs the workspace's whole package.json tree into the extension host's
	// memory, every platform's optional native binaries included — `typescript@7` alone is 20 × ~35 MB `tsc` builds.
	// ata.ts acquires just the type surface, into the workspace store, instead.
	"js/ts.tsserver.web.typeAcquisition.enabled": false,
	"search.exclude": {
		"**/package-lock.json": true
	},
	"typescript.format.insertSpaceAfterFunctionKeywordForAnonymousFunctions": false,
	"typescript.format.insertSpaceBeforeFunctionParenthesis": false,
	"typescript.tsserver.web.typeAcquisition.enabled": false
}
