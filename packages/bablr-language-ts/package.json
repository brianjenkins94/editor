{
  "name": "@brianjenkins94/bablr-language-ts",
  "version": "0.0.0",
  "description": "Our own BABLR grammar for the modern-TypeScript subset tsval interprets — a lossless CSTML substrate for the capability IDE.",
  "type": "module",
  "scripts": {
    "parse": "tsx run.mjs",
    "probe": "tsx test/probe.mjs",
    "probe:all": "tsx test/probe-all.mjs",
    "test": "for f in test/cases-*.txt; do tsx test/probe-all.mjs $f | tail -1; done",
    "test:roundtrip": "tsx test/roundtrip.mjs --fast",
    "test:roundtrip:full": "tsx test/roundtrip.mjs --fast --full",
    "test:failures": "tsx test/failures.mjs",
    "test:spans": "tsx test/spans.mjs",
    "test:cosmetic": "tsx test/cosmetic.mjs"
  },
  "dependencies": {
    "@bablr/agast-helpers": "latest",
    "@bablr/agast-vm-helpers": "latest",
    "@bablr/cli": "latest",
    "@bablr/helpers": "latest",
    "@bablr/language-en-blank-space": "latest",
    "@bablr/language-en-esnext": "latest",
    "bablr": "latest"
  },
  "devDependencies": {
    "@bablr/language-en-c-comments": "latest",
    "@brianjenkins94/util": "https://brianjenkins94.github.io/lib/util@latest.tgz",
    "@bablr/language-en-es5": "latest",
    "@bablr/language-en-es6": "latest",
    "@bablr/language-en-json": "latest",
    "tsx": "latest",
    "typescript": "^6"
  }
}
