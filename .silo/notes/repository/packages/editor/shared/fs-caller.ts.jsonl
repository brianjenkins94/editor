{"id":"7cad3f8f-599b-4e02-8b66-bd01bdb7b2c3","kind":"note","ref":{"span":"6c8e6bbd12efd552","key":"bablr1","file":"packages/editor/shared/fs-caller.ts","baseline":{"blob":"fb52e7f2da436ddc6ef2ab12166a3ddff2dd7e2c","start":856,"end":1039},"shape":{"type":"ExportDeclaration","atoms":["export","function","asCaller","<","T",">","(","name",":","string",",","run",":","(",")","=>","T",")",":","T","{","const","before","=","state",".","current",";","state",".","current","=","name",";","try","{","return","run","(",")",";","}","finally","{","state",".","current","=","before",";","}","}"]},"context":{"before":"4c5c7528e159a264","after":"fc732861b93d6aa4"}},"payload":{"text":"`run` as `name`'s call: whatever store operations it makes synchronously are `name`'s.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:54:03.136Z","updatedAt":"2026-11-22T16:54:03.136Z"}
{"id":"9338673a-4647-4c97-b0a7-a99e2ace0b1d","kind":"note","ref":{"span":"1ff78930b4db896b","key":"bablr1","file":"packages/editor/shared/fs-caller.ts","baseline":{"blob":"ee0e8ee37101105996acc7c2b383797dd7709db9","start":2854,"end":2941},"shape":{"type":"VariableDeclaration","atoms":["const","FILE_SERVICE","=","/","^(?:FileService|FileServiceOverride|OverlayFileSystemProvider)$","/","u"]},"context":{"before":"a1f577d7dcd073a6","after":"172f9643df05c884"}},"payload":{"text":"VS Code's file service and the overlays between it and a provider: the asker is past these on a call's stack.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:54:00.784Z","updatedAt":"2026-11-22T16:54:00.784Z"}
{"id":"aa204e64-381d-415a-9a69-fdad37cbfefc","kind":"note","ref":{"span":"058c39b67d1c6fc8","key":"bablr1","file":"packages/editor/shared/fs-caller.ts","baseline":{"blob":"db81a624f7143ef868d5029c03c3fa2e1f60fc6e","start":3450,"end":4095},"shape":{"type":"ExportDeclaration","atoms":["export","function","vscodeCaller","(",")",":","string","{","const","prepare","=","Error",".","prepareStackTrace",";","const","limit","=","Error",".","stackTraceLimit",";","let","sites",":","CallSite","[]",";","Error",".","prepareStackTrace","=","(","_",",","frames",")","=>","frames",";","Error",".","stackTraceLimit","=","STACK_FRAMES",";","try","{","sites","=","new","Error","(","\"","caller","\"",")",".","stack","as","unknown","as","CallSite","[]",";","}","finally","{","Error",".","prepareStackTrace","=","prepare",";","Error",".","stackTraceLimit","=","limit",";","}","let","past","=","false",";","for","(","const","site","of","sites",")","{","const","type","=","site",".","getTypeName","(",")",";","if","(","type","!==","null","&&","FILE_SERVICE",".","test","(","type",")",")","{","past","=","true",";","}","else","if","(","past","&&","type","!==","null","&&","!","NOBODY",".","has","(","type",")",")","{","return","type",";","}","}","return","\"","vscode","\"",";","}"]},"context":{"before":"57fed499856657a3"}},"payload":{"text":"Who in VS Code is calling its file service, from the provider it reached: the class of the first method on the\nstack past the file service — awaits included, as V8 keeps them — such as `WorkspaceSearch` (file search's walk) or\n`MainThreadFileSystem` (an extension's `workspace.fs`), or `vscode` where the stack doesn't reach one (it ends at a\n`Promise.all`). Read from the stack's call sites, not its text: about 2 µs, against a provider call's 70.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:53:57.873Z","updatedAt":"2026-11-22T16:53:57.873Z"}
