{"id":"711ad917-ea62-4938-8531-0a062be3b0f2","kind":"note","ref":{"span":"e35b707c7585ec53","key":"bablr1","file":"packages/editor/shared/fs-caller.ts","baseline":{"blob":"6631da94269d4bae895403695f56876b84944fc2","start":460,"end":613},"shape":{"type":"VariableDeclaration","atoms":["const","state","=","(","(","globalThis","as","Record","<","symbol",",","unknown",">",")","[","Symbol",".","for","(","\"","editor.fs-caller","\"",")","]","??=","{","\"","current","\"",":","undefined","}",")","as","{","\"","current","\"",":","string","|","undefined","}"]},"context":{"after":"4c5c7528e159a264"}},"payload":{"text":"The caller now, on the realm's global: one for every bundle loaded into it (the workbench's, an extension's).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:54:03.897Z","updatedAt":"2026-11-22T16:54:03.897Z"}
