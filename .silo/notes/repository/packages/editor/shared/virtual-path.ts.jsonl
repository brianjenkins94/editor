{"id":"22718100-ebfc-48d0-94eb-6df85df265dc","kind":"note","ref":{"span":"8f4b103d71201b33","key":"bablr1","file":"packages/editor/shared/virtual-path.ts","baseline":{"blob":"32dab8d0bf4681eda4c220464609732346c8e5eb","start":358,"end":421},"shape":{"type":"VariableDeclaration","atoms":["const","VIRTUAL_RE","=","/","\\/__virtual__\\/([^/]+)\\/(\\d+)(\\/[^?#]*|$)","/","u"]},"context":{"after":"52d8e0cdbcf01d6a"}},"payload":{"text":"An address in a path: groups `tab`, `port`, and the rest of the path (from its `/`, or empty).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:56:01.575Z","updatedAt":"2026-11-22T16:56:01.575Z"}
{"id":"743e3f8f-0f43-4a03-b48d-d7c931225505","kind":"note","ref":{"span":"ee9bd327e5a45b62","key":"bablr1","file":"packages/editor/shared/virtual-path.ts","baseline":{"blob":"1806d16a4b2b408672ef8805d7b11410ef49b9b2","start":819,"end":834},"shape":{"type":"PropertySignature","atoms":["\"","rest","\"",":","string",";"]},"context":{"before":"b96688ee9c61025b","after":"6e72939c89734488"}},"payload":{"text":"The path on the server (`/…`), or \"\" for the bare `…/<port>`.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:56:01.127Z","updatedAt":"2026-11-22T16:56:01.127Z"}
{"id":"915bd44f-2ab1-437a-89e3-71396d7fb1b4","kind":"note","ref":{"span":"6e72939c89734488","key":"bablr1","file":"packages/editor/shared/virtual-path.ts","baseline":{"blob":"59b2b25a88c84433d8de129ad9ef306afbfd2e2a","start":906,"end":923},"shape":{"type":"PropertySignature","atoms":["\"","prefix","\"",":","string",";"]},"context":{"before":"ee9bd327e5a45b62","after":"ae40a1b30d3aa84f"}},"payload":{"text":"Everything up to and including the port (`<base>/__virtual__/<tab>/<port>`), for redirects.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:56:00.893Z","updatedAt":"2026-11-22T16:56:00.893Z"}
{"id":"a953e04d-f045-4d36-b183-9b0e6cd4ab92","kind":"note","ref":{"span":"8f4b103d71201b33","key":"bablr1","file":"packages/editor/shared/virtual-path.ts","baseline":{"blob":"9c3a64622c3c01221ddba6334720a7eccc38bfa9","start":1,"end":64},"shape":{"type":"VariableDeclaration","atoms":["const","VIRTUAL_RE","=","/","\\/__virtual__\\/([^/]+)\\/(\\d+)(\\/[^?#]*|$)","/","u"]},"context":{"after":"52d8e0cdbcf01d6a"}},"payload":{"text":"A dev server's address, built and parsed only here: `<base>/__virtual__/<tab>/<port>/<path>`, this origin. The service\nworker answers it by calling that tab's server on `port`. Found anywhere in a path, never anchored: under Pages the\neditor, and so every address, is below `/editor/`.\n\nDependency-free: the service worker bundles it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:56:01.785Z","updatedAt":"2026-11-22T16:56:01.785Z"}
{"id":"c3fabbf0-4d0f-4645-8266-8839e6c44ed0","kind":"note","ref":{"span":"52d8e0cdbcf01d6a","key":"bablr1","file":"packages/editor/shared/virtual-path.ts","baseline":{"blob":"70d0bf55abbd718d739f2498a5339e03a1b9849c","start":526,"end":659},"shape":{"type":"ExportDeclaration","atoms":["export","function","virtualUrl","(","base",":","string",",","tab",":","string",",","port",":","number",")",":","string","{","return","`","","${","base","}","__virtual__/","${","tab","}","/","${","String","(","port",")","}","/","`",";","}"]},"context":{"before":"8f4b103d71201b33","after":"816d9e96fca998d1"}},"payload":{"text":"The address of `tab`'s server on `port`, under the deploy `base` (which ends in `/`).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:56:01.341Z","updatedAt":"2026-11-22T16:56:01.341Z"}
