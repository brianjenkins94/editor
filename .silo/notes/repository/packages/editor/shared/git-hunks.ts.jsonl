{"id":"85377d7f-c2d3-4985-9135-3a5ad10c1d81","kind":"note","ref":{"span":"665a009baee61477","key":"bablr1","file":"packages/editor/shared/git-hunks.ts","baseline":{"blob":"5554ae0e53224c8f61d676706d4ebd020ca2c77b","start":5971,"end":6578},"shape":{"type":"ExportDeclaration","atoms":["export","function","committedContent","(","head",":","string",",","working",":","string",",","rows",":","DiffRowInfo","[]",",","left",":","ReadonlySet","<","number",">",")",":","string","{","const","[","headLines",",","workingLines","]","=","[","linesOf","(","head",")",",","linesOf","(","working",")","]",";","return","rows",".","flatMap","(","(","row",",","index",")","=>","{","const","kept","=","left",".","has","(","index",")",";","if","(","row",".","type","===","\"","ctx","\"",")","{","return","[","workingLines","[","row",".","rightNo","-","1","]","]",";","}","if","(","row",".","type","===","\"","add","\"",")","{","return","kept","?","[","]",":","[","workingLines","[","row",".","rightNo","-","1","]","]",";","}","if","(","row",".","type","===","\"","del","\"",")","{","return","kept","?","[","headLines","[","row",".","leftNo","-","1","]","]",":","[","]",";","}","return","[","kept","?","headLines","[","row",".","leftNo","-","1","]",":","workingLines","[","row",".","rightNo","-","1","]","]",";","}",")",".","join","(","\"","\\","\\n","n","\"",")",";","}"]},"context":{"before":"d469c487beb37f80","after":"17dd4e38eb4282d9"}},"payload":{"text":"The text that HEAD becomes with only some changed rows applied: `left` are the row indexes left as HEAD has them —\nan added line dropped, a deleted one kept, a modified one as it was. Committing a selection leaves out what wasn't\npicked; discarding some rows leaves out those.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:54:20.953Z","updatedAt":"2026-11-22T16:54:20.953Z"}
{"id":"8a552b10-5edc-4e6c-b1f7-a74cf24e8abd","kind":"note","ref":{"span":"1dd11584a6dd6476","key":"bablr1","file":"packages/editor/shared/git-hunks.ts","baseline":{"blob":"f0f7ac311161ca6213400e12d8c421c3c1092ead","start":0,"end":67},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","GitFileChange","}","from","\"","@brianjenkins94/editor-api/git","\""]},"context":{"after":"306ad2082c776730"}},"payload":{"text":"A change as hunks: the line diff of a file's HEAD text against its working text, aligned for the side-by-side review\n(`rows`), grouped into hunks with ids (`hunksOf`), and a selection of them turned back into the text to commit or to\nkeep (`committedContent`). One implementation for every face that picks part of a change — the shell's review panel\nby rows, an agent's `git_commit` / `git_discard` by hunk ids — run in the workbench (git-review.ts\n`git.review`, `git.discard`, and its part of git-service.ts' `git.commit`).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:55:00.479Z","updatedAt":"2026-11-22T16:55:00.479Z"}
