n","[]",")",":","number","=>","{","const","delay","=","Number","(","ms",")","||","0",";","if","(","typeof","handler","!==","\"","function","\"","||","(","realm",".","document","?.","hidden","!==","true","&&","delay","<","LONG_MS",")",")","{","return","(","repeat","?","own",".","setInterval",":","own",".","setTimeout",")","(","handler","as","Callback",",","ms",",","...","args",")","as","unknown","as","number",";","}","const","id","=","next",";","next","+=","1",";","pending",".","set","(","id",",","{","\"","callback","\"",":","handler","as","Callback",",","\"","args","\"",":","args",",","\"","repeat","\"",":","repeat","}",")",";","clock",".","postMessage","(","{","\"","id","\"",":","id",",","\"","ms","\"",":","delay",",","\"","repeat","\"",":","repeat","}",")",";","return","id",";","}",";","const","clear","=","(","theirs",":","(","id","?",":","number",")","=>","void",")","=>","(","id","?",":","number",")",":","void","=>","{","if","(","typeof","id","===","\"","number","\"","&&","id",">=","FIRST_ID",")","{","if","(","pending",".","delete","(","id",")",")","{","clock",".","postMessage","(","{","\"","id","\"",":","id","}",")",";","}","}","else","{","theirs","(","id",")",";","}","}",";","realm",".","setTimeout","=","set","(","false",")","as","unknown","as","typeof","globalThis",".","setTimeout",";","realm",".","setInterval","=","set","(","true",")","as","unknown","as","typeof","globalThis",".","setInterval",";","realm",".","clearTimeout","=","clear","(","own",".","clearTimeout","as","(","id","?",":","number",")","=>","void",")","as","typeof","globalThis",".","clearTimeout",";","realm",".","clearInterval","=","clear","(","own",".","clearInterval","as","(","id","?",":","number",")","=>","void",")","as","typeof","globalThis",".","clearInterval",";","}"]},"context":{"before":"0b5db7b71d396c18","after":"66d1d6ae9104ebf6"}},"payload":{"text":"Give `realm` timers that keep time in a hidden tab (once a realm; none where it can't make a worker).","wrote":["Brian Jenkins"]},"author"