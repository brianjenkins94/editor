{"id":"478d0ce0-c706-4d68-9bd7-680d2ef245b5","kind":"note","ref":{"span":"2a02980fcb2d97cb","key":"bablr1","file":"packages/editor/shared/hidden-timers.ts","baseline":{"blob":"9b794811117c2ca7b78f9f24f5a3aa4531dc40da","start":1131,"end":1476},"shape":{"type":"VariableDeclaration","atoms":["const","CLOCK","=","\"","const timers = new Map(); onmessage = ({ data }) => { const { id, ms, repeat } = data; clearTimeout(timers.get(id)); clearInterval(timers.get(id)); timers.delete(id); if (ms !== undefined) { timers.set(id, repeat ? setInterval(() => { postMessage(id); }, ms) : setTimeout(() => { timers.delete(id); postMessage(id); }, ms)); } };","\""]},"context":{"before":"e03241e9a1ad291a","after":"7ceb7a42f11ac10d"}},"payload":{"text":"The worker: a timer (or an interval) per id, its id posted back each time it fires; an id alone clears it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T16:55:09.066Z","updatedAt":"2026-11-22T16:55:09.066Z"}
