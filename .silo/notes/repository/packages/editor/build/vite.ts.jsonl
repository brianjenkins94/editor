{"id":"08baca72-c57d-42cc-853b-375096fb632b","kind":"note","ref":{"span":"f777ebc13a6ccbf9","key":"bablr1","file":"packages/editor/build/vite.ts","baseline":{"blob":"b25b13a2dbcc976a27f4091903062d0f34f67f8b","start":3301,"end":3724},"shape":{"type":"ExportDeclaration","atoms":["export","function","workbenchPreloadPlugin","(",")",":","Plugin","{","return","{","\"","name","\"",":","\"","workbench-preload","\"",",","\"","apply","\"",":","\"","build","\"",",","\"","transformIndexHtml","\"",":","(",")","=>","[","\"","workbench.js","\"",",","\"","main.js","\"",",","...","componentStaticChunks","(","componentDistDirectory","(",")",")","]",".","map","(","(","file",")","=>","(","{","\"","tag","\"",":","\"","link","\"",",","\"","attrs","\"",":","{","\"","rel","\"",":","\"","preload","\"",",","\"","as","\"",":","\"","script","\"",",","\"","crossorigin","\"",":","\"","","\"",",","\"","fetchpriority","\"",":","\"","low","\"",",","\"","href","\"",":","MOUNT",".","slice","(","1",")","+","file","}",",","\"","injectTo","\"",":","\"","head","\"","as","const","}",")",")","}",";","}"]},"context":{"before":"69879ecbcd6c728b","after":"5b0d21ee7146a291"}},"payload":{"text":"Preload the workbench's boot chunks from the site's index.html, so they download while the shell and the app iframe\nare still starting — before the workbench iframe that imports them even exists. A plain `preload` (fetch only: no\nparse or compile in this document, which shares the iframes' main thread); the iframe then gets them from the HTTP\ncache. BUILD only: the dev server sends no cache headers, so the iframe couldn't reuse them there.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:10:40.726Z","updatedAt":"2026-11-22T17:10:40.726Z"}
{"id":"2b9f96f9-6809-4219-b791-9f10f53d5489","kind":"note","ref":{"span":"19ac55073133c254","key":"bablr1","file":"packages/editor/build/vite.ts","baseline":{"blob":"35b77a0a867c492121f27077fcc9ccb89202acd0","start":5023,"end":5067},"shape":{"type":"VariableDeclaration","atoms":["const","roots","=","[","workbenchDist",",","componentDist","]"]},"context":{"before":"37e3770b402b8229","after":"2a7de95019723666"}},"payload":{"text":"Workbench entry first (host/workbench), then the component bundle (main.js + assets).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:10:37.145Z","updatedAt":"2026-11-22T17:10:37.145Z"}
