lice","(","-","MAX_HITS",")",";","stop",".","hits",".","slice","(","0",",","-","MAX_REPLAYS",")",".","forEach","(","(","older",")","=>","{","delete","older",".","replay",";","}",")",";","const","recording","=","calls",".","at","(","-","1",")",";","if","(","recording","!==","undefined",")","{","recording",".","hit","=","hit",";","}","stops",".","set","(","key",",","stop",")",";","stopTimer","??=","setTimeout","(","stopsNow",",","STOP_REPORT_MS",")",";","}"]},"context":{"before":"17d06aa533e71dd8","after":"516cae67636d5123"}},"payload":{"text":"A stop of `file`'s `version` hit: what's in scope, previewed now (a value read later would be what it became).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:57:17.071Z","updatedAt":"2026-11-22T17:57:17.071Z"}
{"id":"1bda9ad6-b2ce-4dd9-8ff7-c7b4ec9207cc","kind":"note","ref":{"span":"f4554adca5c6fa7b","key":"bablr1","file":"packages/editor/previews/page-evidence.ts","baseline":{"blob":"f2b01c443efaabbec2f2d6fcc25d11e01b26e1ff","start":1787,"end":1828},"shape":{"type":"TypeAliasDeclaration","atoms":["type","SiteKind","=","\"","statement","\"","|","ObserveSite"]},"context":{"before":"dd091ccf9708e6b1","after":"17cb09c9a7274465"}},"payload":{"text":"What a site of a module records: a statement (coverage), or one of tsval's observe sites (instrument.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:58:20.769Z","updatedAt":"2026-11-22T17:58:20.769Z"}
{"id":"2a30b879-3aa4-4c33-83fc-6f47c7830dda","kind":"note","ref":{"span":"05f09b713e203610","key":"bablr1","file":"packages/editor/previews/page-evidence.ts","baseline":{"blob":"cecaed0e1fdabc4c748e8379f75a50d34a0c28b9","start":0,"end":65},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","SiteObservation","}","from","\"","@brianjenkins94/editor-api","\""]},"context":{"after":"87849e9fe6be0f12"}},"payload":{"text":"The page runtime of runtime evidence (RUNTIME-EVIDENCE.md, the third slice): what a preview's instrumented modules\n(almostnode's frameworks/instrument.ts) tell `globalThis.__evidence`, counted in the page — statements as they start,\nwhat went through each site — and reported to the editor (page-script.ts).\n\nCounts are page-global, by file and version (the module source's git blob oid): a module a hot update re-imports\nwith an edit counts into its new version, one re-imported unchanged counts on into its old one; a module's own scope\nwould lose them on every update. A report is a page's totals since it loaded, not what changed since the last, so a\nlost one costs nothing. A page reports every 10 seconds while its counts change, on each hot update (before the\nmodule is re-imported), and on `pagehide`.\n\nRecorded stops (RUNNING.md: a breakpoint in a page) are told here too (`p`): each time a stop's line runs, what was in\nscope — each value previewed then, as the margin shows a live value — with `this`, the event the page was handling\nand the functions it was in; the latest of each stop's hits kept, and reported soon after (not every 10 seconds: a\nstop is looked at as it happens).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:58:24.916Z","updatedAt":"2026-11-22T17:58:24.916Z"}
{"id":"388819fe-4912-4adb-934f-33a661751f4e","kind":"note","ref":{"span":"03d7a2a7b0e21169#0","key":"bablr1","file":"packages/editor/previews/page-evidence.ts","baseline":{"blob":"e9a1369ac3353d7950d5cf36b31b6c676c1dcd70","start":2099,"end":2108},"shape":{"type":"Keyword","atoms":["interface"]},"context":{"before":"17cb09c9a7274465","after":"0cd2815e6b01d784#0"}},"payload":{"text":"The runtime operations an instrumented module calls (instrument.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:58:12.214Z","updatedAt":"2026-11-22T17:58:12.214Z"}
