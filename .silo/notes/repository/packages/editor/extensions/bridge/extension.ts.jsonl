{"id":"692e3134-0ec1-49bb-af58-e5e645498fd3","kind":"note","ref":{"span":"7c280ccd7a35a235","key":"bablr1","file":"packages/editor/extensions/bridge/extension.ts","baseline":{"blob":"c6b15bc474ce69ac324bef1aacdc8b46654fa04c","start":2127,"end":2188},"shape":{"type":"VariableDeclaration","atoms":["const","{","\"","log","\"",":","bridgeLog",",","architecture","}","=","observe","(","bridgeHub",")"]},"context":{"before":"34b0abe1110cfc3e","after":"c0a7f923436fdebd"}},"payload":{"text":"The bridge's logger (its spans/records ride bridgeHub), its uncaught errors, and its hub's topology/traffic — not its\nnetwork: this extension host shares the workbench realm, whose network is probed there.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:15:47.610Z","updatedAt":"2026-11-22T17:15:47.610Z"}
{"id":"6c714254-711b-4251-a582-129d657e876a","kind":"note","ref":{"span":"cd0c6bcfbfb0fdf1","key":"bablr1","file":"packages/editor/extensions/bridge/extension.ts","baseline":{"blob":"06244207594ff54be9bd0a0070b6e1c4bcb73a56","start":0,"end":51},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","CommandTotals","}","from","\"","../command-tap","\""]},"context":{"after":"e725ab7b93086594"}},"payload":{"text":"The bridge between the editor's core runtime and VS Code (runs in the LocalProcess extension host,\nwhich shares the workbench's realm): core's vscode API is this extension's, and everything of core's that VS Code\nshows or drives crosses here — the hub's uplink, every debugger's editor-api events and capability stops, and the\nworkspace runtime it gives a debugger (tsval: extensions/tsval). Feature extensions use the public API only; this is\nthe one that touches the hub.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:15:53.371Z","updatedAt":"2026-11-22T17:15:53.371Z"}
{"id":"7ef1f1e4-a5e6-4f7b-b2ba-064bac71d52a","kind":"note","ref":{"span":"94f7a27d0d7729ad","key":"bablr1","file":"packages/editor/extensions/bridge/extension.ts","baseline":{"blob":"adcb09b2a9e764be4346941d1ca293ca6e188ec1","start":9636,"end":9732},"shape":{"type":"If","atoms":["if","(","!","canTrack",")","{","bridgeHub",".","publish","(","`","debug.declined.","${","info",".","runId","}","","`",",","{","}",")",";","return",";","}"]},"context":{"before":"b029e29f11049b09","after":"fd4204d09bdd126e"}},"payload":{"text":"Can't track session end → decline: the terminal says the debugger couldn't take it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:15:19.781Z","updatedAt":"2026-11-22T17:15:19.781Z"}
