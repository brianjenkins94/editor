{"id":"4f1ae458-bd04-46fd-a7be-f80853465c50","kind":"note","ref":{"span":"cf118880892fc8ce","key":"bablr1","file":"packages/editor/extensions/tsval/debug-protocol.ts","baseline":{"blob":"ea2cf887dd935dd9bd49d9f0cfc563e7d5a9f157","start":5021,"end":5128},"shape":{"type":"ExportDeclaration","atoms":["export","interface","Variable","{","\"","name","\"",":","string",";","\"","value","\"",":","string",";","\"","type","\"",":","string",";","\"","variablesReference","\"",":","number","}"]},"context":{"before":"006502713ecb03d0","after":"8b65190bd594efdb"}},"payload":{"text":"A rule placed in the code (RUNNING.md, *A rule placed in the code*), found in the text that runs: the 1-based line\nits statement starts on, the place, and the rule — whose `set`s are made each time that statement has run, if it\nmatches there.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:08:35.385Z","updatedAt":"2026-11-22T18:08:35.385Z"}
