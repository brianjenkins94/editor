{"id":"42df65d3-15e7-409b-a8ba-88e8defeacb4","kind":"note","ref":{"span":"e6522924607defdd","key":"bablr1","file":"packages/editor/extensions/tsval/debug-protocol.ts","baseline":{"blob":"33b1bb77dceba708f7a83b2fbfd60ae8affd56dd","start":4170,"end":4245},"shape":{"type":"ExportDeclaration","atoms":["export","interface","Printed","{","\"","text","\"",":","string",";","\"","file","\"",":","string",";","\"","line","\"",":","number","}"]},"context":{"before":"d6edaef6e478f693","after":"1b1cfcb691e13e68"}},"payload":{"text":"A line the program printed, exploring: the text, and where the call that printed it is (its file, its 1-based line).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:08:39.829Z","updatedAt":"2026-11-22T18:08:39.829Z"}
