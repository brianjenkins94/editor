{"id":"97f1964d-1028-4711-9a7b-cb7865d9e5b3","kind":"note","ref":{"span":"006502713ecb03d0","key":"bablr1","file":"packages/editor/extensions/tsval/debug-protocol.ts","baseline":{"blob":"ecd34d7c525d02dea4c539a17971a2a727bb50dc","start":4781,"end":4894},"shape":{"type":"ExportDeclaration","atoms":["export","interface","Explored","{","\"","runs","\"",":","number",";","\"","complete","\"",":","boolean",";","\"","outcomes","\"",":","Ordering","[]",";","\"","eventLoop","\"",":","LoopStart","}"]},"context":{"before":"1b1cfcb691e13e68","after":"cf118880892fc8ce"}},"payload":{"text":"What exploring a program's orderings found: how many runs, whether every ordering was run, and the distinct outcomes.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:08:36.799Z","updatedAt":"2026-11-22T18:08:36.799Z"}
