{"id":"aab570db-2b72-4d6c-9154-792d9212ceea","kind":"note","ref":{"span":"bcb541cc17a11c31","key":"bablr1","file":"packages/editor/extensions/tsval/live-run.ts","baseline":{"blob":"50126d43f7ec86260c136779d96a756528810a67","start":7655,"end":7695},"shape":{"type":"MemberExpression","atoms":["vscode",".","workspace",".","onDidChangeTextDocument"]},"context":{"before":"686fa5c6ff04ce41","after":"4469ee527011ceba"}},"payload":{"text":"The edit makes the run going stale. The next save, or the interval, runs it again.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:10:17.889Z","updatedAt":"2026-11-22T18:10:17.889Z"}
