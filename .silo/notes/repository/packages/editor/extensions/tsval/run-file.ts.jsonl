{"id":"3823d8a2-2e53-4d38-9c88-771abff6dd0d","kind":"note","ref":{"span":"def02473d9d4c2be","key":"bablr1","file":"packages/editor/extensions/tsval/run-file.ts","baseline":{"blob":"38332551d49ab8f2143b49fb85ad7d5a290a2786","start":1054,"end":1203},"shape":{"type":"ExportDeclaration","atoms":["export","const","runOf","=","(","file",":","vscode",".","Uri",")",":","vscode",".","DebugConfiguration","=>","(","{","\"","type","\"",":","\"","tsval","\"",",","\"","request","\"",":","\"","launch","\"",",","\"","name","\"",":","\"","Run","\"",",","\"","program","\"",":","file",".","path","}",")"]},"context":{"before":"1b13c6140e38ec6b","after":"85ed2742e7e30af0"}},"payload":{"text":"A run of `file`, as a launch configuration: what it's called is all a person sees of what runs it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:11:01.818Z","updatedAt":"2026-11-22T18:11:01.818Z"}
{"id":"e8b391f0-fe48-4cfd-8db8-4cca9531fa8a","kind":"note","ref":{"span":"85ed2742e7e30af0","key":"bablr1","file":"packages/editor/extensions/tsval/run-file.ts","baseline":{"blob":"3b9aa43f824701718adb7a34d795dc2c61223633","start":1312,"end":1447},"shape":{"type":"ExportDeclaration","atoms":["export","function","nothingToRun","(",")",":","void","{","void","vscode",".","window",".","showInformationMessage","(","\"","Open a JavaScript or TypeScript file to run it.","\"",")",";","}"]},"context":{"before":"def02473d9d4c2be","after":"fdbc881e4b3c6324"}},"payload":{"text":"There's nothing to run: said, rather than a run that can't read its program.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:11:01.417Z","updatedAt":"2026-11-22T18:11:01.417Z"}
{"id":"f1a21279-4f2f-40a1-a94d-033a06a722c9","kind":"note","ref":{"span":"0b63740c2729e487","key":"bablr1","file":"packages/editor/extensions/tsval/run-file.ts","baseline":{"blob":"5afcc7d9207c42ad48432d5227ca3223bb074cc2","start":0,"end":52},"shape":{"type":"ImportDeclaration","atoms":["import","{","logger","}","from","\"","@brianjenkins94/util/logger","\""]},"context":{"after":"f2517b5f32f25ee8"}},"payload":{"text":"Run (RUNNING.md, *The model*): the one action, on a file. The editor's play button and the palette's *Debug: Run* run the file\nthey're on, and F5 with no launch.json runs the one you're looking at, each as the same session.\n\nWhat it runs is a code file on disk, never what the active editor happens to be: with the Output view focused that's its channel,\nwhich isn't a file a run could read.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:11:02.221Z","updatedAt":"2026-11-22T18:11:02.221Z"}
