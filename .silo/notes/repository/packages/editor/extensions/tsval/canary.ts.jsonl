{"id":"b24162b3-f3a9-4af8-a8af-269fc7aee6f1","kind":"note","ref":{"span":"a0b013ea027c31e2","key":"bablr1","file":"packages/editor/extensions/tsval/canary.ts","baseline":{"blob":"9203ac613531b2ae4404279c7e55d9f1db394fd8","start":4797,"end":5671},"shape":{"type":"ExportDeclaration","atoms":["export","function","givenAs","(","capability",":","string",",","real",":","unknown",",","value",":","unknown",")",":","unknown","{","const","text","=","typeof","value","===","\"","string","\"","?","value",":","JSON",".","stringify","(","value",")",";","const","settle","=","(","shaped",":","unknown",")",":","unknown","=>","(","real","instanceof","Promise","?","Promise",".","resolve","(","shaped",")",":","shaped",")",";","if","(","capability","===","\"","net","\"",")","{","const","json","=","(",")",":","Promise","<","unknown",">","=>","new","Promise","(","(","resolve",")","=>","{","resolve","(","typeof","value","===","\"","string","\"","?","JSON",".","parse","(","value",")","as","unknown",":","value",")",";","}",")",";","return","settle","(","{","\"","ok","\"",":","true",",","\"","status","\"",":","200",",","\"","statusText","\"",":","\"","OK","\"",",","\"","json","\"",":","json",",","\"","text","\"",":","(",")","=>","Promise",".","resolve","(","text",")",",","\"","arrayBuffer","\"",":","(",")","=>","Promise",".","resolve","(","new","TextEncoder","(",")",".","encode","(","text",")",".","buffer",")","}",")",";","}","if","(","capability","===","\"","fs:read","\"",")","{","return","settle","(","text",")",";","}","if","(","capability","===","\"","exec","\"",")","{","return","settle","(","typeof","real","===","\"","object","\"","&&","real","!==","null","&&","\"","stdout","\"","in","real","?","{","...","real",",","\"","stdout","\"",":","text","}",":","text",")",";","}","return","real",";","}"]},"context":{"before":"727ecb6de46989a0","after":"7a58b186b6c963e7"}},"payload":{"text":"A stand-in's result as a rule gives it (RUNNING.md, *A call's result*), in the shape the call returns — `real