{"id":"1a3eebbb-66e8-4988-ab5f-d4fb51b67606","kind":"note","ref":{"span":"6c2e2af33301ecf8","key":"bablr1","file":"packages/editor/extensions/cosmetic/extension.ts","baseline":{"blob":"204607667438f68a06632860605f448b8c067aa2","start":1086,"end":1114},"shape":{"type":"VariableDeclaration","atoms":["const","FIRST_READ_MS","=","30_000"]},"context":{"before":"f3c47c47238abcc2","after":"f1d8ac56eb2467a0"}},"payload":{"text":"How long after the editor starts before the first read: a git status and BABLR's parses are work the boot (and\nTypeScript's first answers) shouldn't share a thread with, and a change made sooner is read as it's saved.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:06.821Z","updatedAt":"2026-11-22T17:27:06.821Z"}
{"id":"aa139058-80e7-41fd-b72f-7a660c847368","kind":"note","ref":{"span":"1dd11584a6dd6476","key":"bablr1","file":"packages/editor/extensions/cosmetic/extension.ts","baseline":{"blob":"242a658e843d12d3f53a124689cfd747aa543cba","start":0,"end":67},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","GitFileChange","}","from","\"","@brianjenkins94/editor-api/git","\""]},"context":{"after":"84ccdac7aaa3e632"}},"payload":{"text":"Cosmetic changes (ARCHITECTURE.md's worked example, the classifier as an extension of its own): a changed file whose\nchange is formatting or comments only — by BABLR's verdict of HEAD against the working tree — marked with a file\ndecoration (a ≈ badge, its name dimmed), which VS Code draws wherever the file is listed: Source Control, the Explorer,\ntabs. Knows nothing of how git is kept: the changes come through the editor's git commands, the verdicts through the\neditor's BABLR (`editor.annotations.classify`, sharing its cached parses) — ARCHITECTURE.md, *Extension points* 5.\n\n`cosmetic.list`: each changed code file's verdict, as last read.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:09.329Z","updatedAt":"2026-11-22T17:27:09.329Z"}
{"id":"c34c18d6-f0b5-4a89-8771-581304d0d6a1","kind":"note","ref":{"span":"f3c47c47238abcc2","key":"bablr1","file":"packages/editor/extensions/cosmetic/extension.ts","baseline":{"blob":"23327ba7baa2e0eaed4b4c079edf6589329d0485","start":1004,"end":1026},"shape":{"type":"VariableDeclaration","atoms":["const","SETTLE_MS","=","2000"]},"context":{"before":"41b265dd325093ef","after":"6c2e2af33301ecf8"}},"payload":{"text":"How long after a change the files are read again.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:08.522Z","updatedAt":"2026-11-22T17:27:08.522Z"}
