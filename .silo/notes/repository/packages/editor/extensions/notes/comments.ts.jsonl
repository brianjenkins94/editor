{"id":"1a7e086e-6231-4a92-84b3-3e47e3a49cbc","kind":"note","ref":{"span":"84df14f202385262","key":"bablr1","file":"packages/editor/extensions/notes/comments.ts","baseline":{"blob":"6efe136d7eadc0244a64cee9c7d0e94fe9187508","start":358,"end":450},"shape":{"type":"VariableDeclaration","atoms":["const","directive","=","(","line",":","string",")",":","boolean","=>","FOR_TOOLS",".","test","(","line",".","replace","(","/","^\\s*\\/\\/ ?","/","u",",","\"","","\"",")",")"]},"context":{"before":"54e8a1607c6e8b0d","after":"c367f4b3f95f34de"}},"payload":{"text":"A `//` line that's a tool's: its own comment, never part of a run beside it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T19:22:18.196Z","updatedAt":"2026-11-22T19:22:18.196Z"}
