{"id":"68bd52e6-cd3d-4d0c-8bfb-ea536ec73e96","kind":"note","ref":{"span":"fa5c0c1596c0f81b","key":"bablr1","file":"packages/editor/extensions/cspell/dictionaries.ts","baseline":{"blob":"b09b2b77cdf64df441e3b535f6ddb0b311a49bd7","start":0,"end":110},"shape":{"type":"ExportDeclaration","atoms":["export","interface","Dictionary","{","\"","name","\"",":","string",";","\"","package","\"",":","string",";","\"","file","\"",":","string",";","\"","languages","\"","?",":","string","[]",";","}"]},"context":{"after":"4fca2f8d13c6324d"}},"payload":{"text":"The cspell dictionaries the editor loads: cspell's own defaults for code (cspell-bundled-dicts' default config) — English,\ncompany and software terms everywhere; TypeScript, Node and npm words in code and JSON; HTML and CSS words where those\nare written. Each is a file of its @cspell package, served beside the language server (build.ts `cspellDict`), fetched\ninto its file system (server-host.ts) and enabled for its languages (server-node.ts). A repository's own words\n(a cspell config's) aren't read: the server checks with these alone.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:14.533Z","updatedAt":"2026-11-22T17:27:14.533Z"}
{"id":"9b048031-8585-4a84-b323-b2314f7200b8","kind":"note","ref":{"span":"0dce8324e13320c9","key":"bablr1","file":"packages/editor/extensions/cspell/dictionaries.ts","baseline":{"blob":"61a14e1f22d429a1a478e490bc08f84266128549","start":2376,"end":2571},"shape":{"type":"ExportDeclaration","atoms":["export","function","servedName","(","dictionary",":","Dictionary",")",":","string","{","const","base","=","dictionary",".","file",".","slice","(","dictionary",".","file",".","lastIndexOf","(","\"","/","\"",")","+","1",")",";","return","dictionary",".","name","+","base",".","slice","(","base",".","indexOf","(","\"",".","\"",")",")",";","}"]},"context":{"before":"f9ce789c05b71c4b"}},"payload":{"text":"Its file's name where it's served and in the server's file system: its name, with its file's extension.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:13.558Z","updatedAt":"2026-11-22T17:27:13.558Z"}
{"id":"a9926381-e9c0-4ca0-9df3-1503f8e7a988","kind":"note","ref":{"span":"fda29dc276e53d25","key":"bablr1","file":"packages/editor/extensions/cspell/dictionaries.ts","baseline":{"blob":"255f847233acf6dce3c09aadae72f352d7a9f76d","start":728,"end":751},"shape":{"type":"PropertySignature","atoms":["\"","languages","\"","?",":","string","[]",";"]},"context":{"before":"00d92a8bd4534fc7","after":"4fca2f8d13c6324d"}},"payload":{"text":"The languages it's for (VS Code's ids); none, every one.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:27:14.041Z","updatedAt":"2026-11-22T17:27:14.041Z"}
