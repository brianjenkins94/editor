")",")",".","map","(","(","[","key",",","status","]",")","=>","`","","${","status","}"," ","${","features",".","get","(","key",")","?.","facet","??","\"","","\"","}"," ","${","features",".","get","(","key",")","?.","id","??","key","}","","`",")",";","if","(","told",".","length",">","0",")","{","output",".","appendLine","(","`","","${","new","Date","(",")",".","toISOString","(",")","}"," runs: ","${","told",".","join","(","\"","; ","\"",")","}","","`",")",";","}","}","exercised","=","now",";","}"]},"context":{"before":"76b6979cf3cbcf27","after":"4480a0b43149b901"}},"payload":{"text":"Join each feature's code with what ran in its file as it is now, and tell what changed in that.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:36:53.481Z","updatedAt":"2026-11-22T17:36:53.481Z"}
{"id":"f3e7d63e-af11-4895-814b-5ea3d52fffeb","kind":"note","ref":{"span":"1f29163bb55c3c5c","key":"bablr1","file":"packages/editor/extensions/history/extension.ts","baseline":{"blob":"fb61becdc50b03cdb1ef1ce9c6613f42c8e3cd9a","start":8249,"end":8735},"shape":{"type":"For","atoms":["for","(","const","feature","of","features",".","values","(",")",")","{","const","declaredOnly","=","(","feature",".","facet","===","\"","command","\"","||","feature",".","facet","===","\"","view","\"",")","&&","feature",".","sides",".","includes","(","\"","declared","\"",")","&&","!","feature",".","sides",".","includes","(","\"","registered","\"",")",";","const","folders","=","feature",".","files",".","filter","(","(","file",")","=>","file",".","endsWith","(","\"","package.json","\"",")",")",".","map","(","(","file",")","=>","file",".","slice","(","0",",","-","\"","package.json","\"",".","length",")",")",";","if","(","declaredOnly","&&","folders",".","some","(","(","folder",")","=>","unread",".","some","(","(","path",")","=>","path",".","startsWith","(","folder",")",")",")",")","{","feature",".","sides",".","push","(","\"","registered","\"",")",";","}","}"]},"context":{"before":"a6e8be046f84b098","after":"92c34e76710a3cd2"}},"payload":{"text":"A command or view a manifest declares and its code doesn't register — while that extension's code isn't all read,\nwhich is what TypeScript's server holds (the projects it's loaded), whether it does can't be said yet: taken as\nregistered until it's read, not called a dead end (nor gone, which leaving it out would make it).\n(silo check on the command line reads every file, and says it there.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:36:39.517Z","updatedAt":"2026-11-22T17:36:39.517Z"}
