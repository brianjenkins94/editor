",","\"","gu","\"",")",")",")","{","if","(","match","[","1","]","===","\"","\\","\\\"","\"","\"","||","match","[","1","]","===","\"","'","\"",")","{","titles",".","add","(","unescaped","(","match","[","2","]",")",")",";","continue",";","}","const","template","=","match","[","3","]","===","undefined","?","match","[","2","]",":","constants",".","get","(","match","[","3","]",")",";","if","(","template","===","undefined",")","{","continue",";","}","const","pattern","=","patternOf","(","template",")",";","if","(","!","pattern",".","includes","(","\"","\\","\\u0000","u","0000","\"",")",")","{","titles",".","add","(","unescaped","(","template",")",")",";","}","else","if","(","pattern",".","replaceAll","(","\"","\\","\\u0000","u","0000","\"",",","\"","","\"",")",".","replaceAll","(","/","\\\\(.)","/","gu",",","\"","$1","\"",")",".","trim","(",")",".","length",">=","WORDS",")","{","titles",".","add","(","new","RegExp","(","`","^","${","pattern",".","replaceAll","(","\"","\\","\\u0000","u","0000","\"",",","\"",".*","\"",")","}","$","`",",","\"","su","\"",")",")",";","}","}","return","titles",";","}"]},"context":{"before":"96f45d61b47ab9c2","after":"9fd501de8d7c84f4"}},"payload":{"text":"The titles a test file declares (`test(\"…\"`, `it(`, `describe(`, `suite(`), as a reporter prints them: a literal as it\nis; one made as it runs — a template (`test262 ${testCase.id}`), or a constant holding one (`test(title, …)`, `const\ntitle = `…``) — as a pattern its words must match, what's put in them anything. A pattern of fewer than WORDS\ncharacters of its own isn't one: it would fit any title.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:12:24.873Z","updatedAt":"2026-11-22T17:12:24.873Z"}
{"id":"3a8d8331-9db0-4a45-b3cb-12d16e357eec","kind":"note","ref":{"span":"a4eb2d27eddc588a","key":"bablr1","file":"packages/editor/workbench/ci-outcomes.ts","baseline":{"blob":"f8578eb74b6c61219f3acc86f24113275925b214","start":0,"end":46},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","Hub","}","from","\"","@brianjenkins94/hub","\""]},"context":{"after":"e44371a09dbded9a"}},"payload":{"text":"How each test has come out in CI (packages/silo/README.md, *Tests by feature, in your face*: \"A test ledger\"): the\nbranch's latest completed runs of each workflow on the workspace's GitHub origin, every attempt's jobs, and the tests\neach job's log reported (lib's `nodeTestOutcomes`), folded into each test's standing (lib's `standings`: its last\nverdict, its streak, its flakes, when it last failed). Nothing is recorded for it: GitHub keeps the runs and their logs.\n\n- `ci.outcomes` { branch? }: those standings, the workspace's branch unless asked of another (none, and `origin` false,\nfor a workspace with no github.com origin). What the table of features and tests reads (features-view.tsx), each\nstanding joined to the test file it's of (`fileOf`).\n\nA finished job's tests are kept here (`.silo/local/ci/outcomes.json`, this machine's: a finished log never changes), so\nonly runs since are asked of GitHub again. A workflow whose latest QUIET runs' logs report no tests (a deploy's) isn't\nread further back. The shell asks GitHub, as ci-status.ts's does (`github.actions`): logs need the sign-in to be GitHub's.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:13:43.713Z","updatedAt":"2026-11-22T17:13:43.713Z"}
{"id":"4889c9d9-817c-435f-bee9-e63ebf5b3513","kind":"note","ref":{"span":"8ea18652cb79b2ae","key":"bablr1","file":"packages/editor/workbench/ci-outcomes.ts","baseline":{"blob":"827e55173dd9731782c1445418137d033dd4a464","start":5981,"end":6511},"shape":{"type":"ExportDeclaration","atoms":["export","function","testsInLog","(","log",":","string",")",":","TestOutcome","[]","{","const","byPackage","=","new","Map","<","string",",","string","[]",">","(",")",";","for","(","const","line","of","log",".","replaceAll","(","/","\\u001B\\[[\\d;]*m","/","gu",",","\"","","\"",")",".","split","(","/","\\r?\\n","/","u",")",")","{","const","match","=","PNPM_LINE",".","exec","(","line",")",";","const","[","key",",","text","]","=","match","===","null","?","[","\"","","\"",",","line","]",":","[","match","[","2","]",",","(","match","[","1","]","??","\"","","\"",")","+","match","[","3","]","]",";","const","lines","=","byPackage",".","get","(","key",")","??","[","]",";","lines",".","push","(","text",")",";","byPackage",".","set","(","key",",","lines",")",";","}","return","[","...","byPackage",".","values","(",")","]",".","flatMap","(","(","lines",")","=>","nodeTestOutcomes","(","lines",".","join","(","\"","\\","\\n","n","\"",")",")",")",".","filter","(","reported",")",";","}"]},"context":{"before":"323fd2d9207aeb32","after":"d37a18046d4e2f56"}},"payload":{"text":"The tests a job's log reported (node:test's spec reporter, lib's `nodeTestOutcomes`): its colours off, and a package's\nlines read apart from another's, pnpm printing them as they come, each after its package's name. A line with no time\nisn't a test's (`reported`).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:12:38.355Z","updatedAt":"2026-11-22T17:12:38.355Z"}
