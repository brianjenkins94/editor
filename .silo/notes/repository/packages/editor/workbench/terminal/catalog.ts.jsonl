{"id":"fb6c15f9-20e6-468c-9ead-bb249d59e3a3","kind":"note","ref":{"span":"7e5424d3e347db43","key":"bablr1","file":"packages/editor/workbench/terminal/catalog.ts","baseline":{"blob":"49582db83ecf1b858f609e87d2fa9a33f8f04788","start":3544,"end":3563},"shape":{"type":"PropertySignature","atoms":["\"","terminal","\"",":","number",";"]},"context":{"before":"4f098256bcabad51","after":"510ee8c1730ae5df"}},"payload":{"text":"This terminal's number: what it runs is attributed to it (runs.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:02:54.108Z","updatedAt":"2026-11-22T18:02:54.108Z"}
{"id":"ff05c007-e932-47b8-815b-9376c5c2798b","kind":"note","ref":{"span":"a5263b5b92d2dca4","key":"bablr1","file":"packages/editor/workbench/terminal/catalog.ts","baseline":{"blob":"4d1e00fe99049473080a3aedd3d345da651d47b2","start":3100,"end":3111},"shape":{"type":"PropertySignature","atoms":["\"","hub","\"",":","Hub",";"]},"context":{"before":"d27ad2c32613b3b7","after":"35e03684ac67ec4e"}},"payload":{"text":"The workbench's hub: to say what a command changed (`git` → `git.changed`, so Source Control refreshes).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:02:56.083Z","updatedAt":"2026-11-22T18:02:56.083Z"}
