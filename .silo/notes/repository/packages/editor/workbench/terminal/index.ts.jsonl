{"id":"46a8e99e-af0a-4149-9c93-f11f9f5f836e","kind":"note","ref":{"span":"838efb38b0b86856","key":"bablr1","file":"packages/editor/workbench/terminal/index.ts","baseline":{"blob":"2d0e83db14e27788b598297be77e24416a46bcb1","start":18383,"end":18648},"shape":{"type":"If","atoms":["if","(","esc",".","length",">=","2","&&","code",">=","0x","40","&&","code","<=","0x","7E",")","{","inEscape","=","false",";","handleEscape","(","esc",")",";","esc","=","\"","","\"",";","}","else","if","(","esc",".","length","===","1","&&","esc","!==","\"","[","\"","&&","esc","!==","\"","O","\"",")","{","inEscape","=","false",";","esc","=","\"","","\"",";","}"]},"context":{"before":"d9de800f5610d26e","after":"655f7eb94b1f3578"}},"payload":{"text":"The final byte of a CSI/SS3 sequence is a letter or `~` (0x40–0x7E); digits and `;` are parameters.\nThe introducer (`[` or `O`) is the first char and never terminates on its own.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:08:12.933Z","updatedAt":"2026-11-22T18:08:12.933Z"}
