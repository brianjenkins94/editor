{"id":"3e4582a0-5b4d-404f-b11f-c29ee28b28a3","kind":"note","ref":{"span":"b3fa63d0493139fb","key":"bablr1","file":"packages/editor/workbench/terminal/index.ts","baseline":{"blob":"96c03d1c95b1f807131dd01e9d1a70739ae0dd39","start":10223,"end":10272},"shape":{"type":"AssignmentExpression","atoms":["captured","=","outputCaptured","(","statements","[","index","]",".","text",")"]},"context":{"before":"f48d57736192ad67","after":"8a21b8c2e8c05c24"}},"payload":{"text":"`signal` is the shell's Ctrl-C: just-bash stops at the next statement boundary and forwards it to a custom\ncommand's `ctx.signal` (so `node` kills its worker). An interrupted run may not reach the PROBE.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:09:21.246Z","updatedAt":"2026-11-22T18:09:21.246Z"}
{"id":"456fa2ca-8b17-4696-8db8-e7c6961ade7d","kind":"note","ref":{"span":"adaa2ef5e0d7ffce","key":"bablr1","file":"packages/editor/workbench/terminal/index.ts","baseline":{"blob":"350fe4ff72f6cf3c06114dabbcc50bdde1daf71e","start":3632,"end":3655},"shape":{"type":"VariableDeclaration","atoms":["let","terminalsOpened","=","0"]},"context":{"before":"57ce6c6f888fc8f5","after":"05fb130f038e1980"}},"payload":{"text":"Terminals opened so far: each one's number names it as the origin of what it runs (runs.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:10:44.661Z","updatedAt":"2026-11-22T18:10:44.661Z"}
