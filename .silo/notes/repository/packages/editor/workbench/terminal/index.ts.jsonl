{"id":"1830b497-ffe9-44eb-92e7-06bb933a316e","kind":"note","ref":{"span":"90bd9ffd554c1b43","key":"bablr1","file":"packages/editor/workbench/terminal/index.ts","baseline":{"blob":"3647f3f29482f0571dc432c2d4afc8cfba2b8000","start":7632,"end":7768},"shape":{"type":"VariableDeclaration","atoms":["const","prompt","=","(",")",":","void","=>","{","fire","(","`","\\","\\r\\n","r","\\","n","${","workingDirectory","(","state",".","cwd",")","}","","${","promptStart","(",")","}","\u001b[1;36m","${","state",".","cwd","}","\u001b[0m $ ","${","commandStart","(",")","}","","`",")",";","}"]},"context":{"before":"41a2aeea0d4019dc","after":"ca8f269eddd7208c"}},"payload":{"text":"Marked for VS Code's shell integration (integration.ts), as a desktop shell's prompt is: where it is, where\nthe prompt starts, where the command line starts. (A redrawn prompt is marked again, as a shell's PS1 would be.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:09:53.351Z","updatedAt":"2026-11-22T18:09:53.351Z"}
