{"id":"23d5163c-379f-4762-b55e-b6024afee0d1","kind":"note","ref":{"span":"0f9ab0c1faf0160c","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"66673af230c5cb0d38c26aa3fab56c832aab10cf","start":1,"end":250},"shape":{"type":"ExportDeclaration","atoms":["export","interface","BashSession","{","\"","exec","\"",":","(","commandLine",":","string",",","options",":","{","\"","cwd","\"",":","string",";","\"","env","\"",":","Record","<","string",",","string",">",";","\"","signal","\"","?",":","AbortSignal","}",")","=>","Promise","<","{","\"","stdout","\"",":","string",";","\"","stderr","\"",":","string",";","\"","exitCode","\"",":","number",";","\"","env","\"",":","Record","<","string",",","string",">","}",">",";","}"]},"context":{"after":"4d181fa0e0f91afb"}},"payload":{"text":"One command of the terminal's session over just-bash (see index.ts for why the session is ours to keep): run it\nwith the session's cwd + env, then read back what just-bash can't hand us itself — the cwd, from a `$PWD` probe\nappended to the command, and the env, from the result.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:44.298Z","updatedAt":"2026-11-22T18:07:44.298Z"}
{"id":"3b15b4cc-4f61-4927-9ec5-996206b51f32","kind":"note","ref":{"span":"0f9ab0c1faf0160c","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"b9f84b641eff22654265f904180d7b531cde6d96","start":297,"end":546},"shape":{"type":"ExportDeclaration","atoms":["export","interface","BashSession","{","\"","exec","\"",":","(","commandLine",":","string",",","options",":","{","\"","cwd","\"",":","string",";","\"","env","\"",":","Record","<","string",",","string",">",";","\"","signal","\"","?",":","AbortSignal","}",")","=>","Promise","<","{","\"","stdout","\"",":","string",";","\"","stderr","\"",":","string",";","\"","exitCode","\"",":","number",";","\"","env","\"",":","Record","<","string",",","string",">","}",">",";","}"]},"context":{"after":"4d181fa0e0f91afb"}},"payload":{"text":"What a just-bash `Bash` offers us: one stateless `exec`.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:42.505Z","updatedAt":"2026-11-22T18:07:42.505Z"}
