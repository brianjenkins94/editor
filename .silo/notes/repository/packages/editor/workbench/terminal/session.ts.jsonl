push","(","{","\"","text","\"",":","input",".","slice","(","start",")",",","\"","then","\"",":","\"","","\"","}",")",";","const","kept","=","statements",".","filter","(","(","statement",")","=>","statement",".","text",".","trim","(",")","!==","\"","","\"",")",";","if","(","kept",".","length","<","2","||","kept",".","some","(","(","statement",")","=>","WHOLE",".","has","(","statement",".","text",".","trim","(",")",".","split","(","/","\\s+","/","u",")","[","0","]",")",")",")","{","return","undefined",";","}","kept","[","kept",".","length","-","1","]",".","then","=","\"","","\"",";","return","kept",";","}"]},"context":{"before":"f1dbc390f0044ae4"}},"payload":{"text":"`input` as its top-level statements, each with what joins it to the next — so a line with a `streaming` command\n(`node`) can be run a statement at a time, each one's output shown before the next runs. Undefined — run it whole —\nwhen it has no streaming command, one statement, or anything a statement-by-statement run would change the meaning\nof: a compound command or a subshell, a here-document, a background job, or a builtin that acts on the shell itself.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:17.680Z","updatedAt":"2026-11-22T18:07:17.680Z"}
{"id":"4d89e779-e412-4f99-8357-bcdce6a0479e","kind":"note","ref":{"span":"0edfb5223eb9288d","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"5fb318285eed690be1c7437c636bd2614fd3e2b6","start":693,"end":711},"shape":{"type":"PropertySignature","atoms":["\"","status","\"","?",":","number",";"]},"context":{"before":"fad39c27b8dfbec8#1","after":"fad9731091df9d08"}},"payload":{"text":"The last statement's exit code, when a line runs a statement at a time (statementsOf): the next one's `$?`.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:40.549Z","updatedAt":"2026-11-22T18:07:40.549Z"}
{"id":"63def3b0-5c3c-4475-886b-b6b8dd0a1ec0","kind":"note","ref":{"span":"7fe0972c2fbc9ab1","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"4e3e4a35c364762dcc2610a9032de14cc785d5cb","start":5138,"end":5355},"shape":{"type":"VariableDeclaration","atoms":["const","WHOLE","=","new","Set","(","[","\"","if","\"",",","\"","then","\"",",","\"","elif","\"",",","\"","else","\"",",","\"","fi","\"",",","\"","for","\"",",","\"","while","\"",",","\"","until","\"",",","\"","do","\"",",","\"","done","\"",",","\"","case","\"",",","\"","esac","\"",",","\"","select","\"",",","\"","function","\"",",","\"","time","\"",",","\"","exit","\"",",","\"","return","\"",",","\"","exec","\"",",","\"","trap","\"",",","\"","set","\"",",","\"","shopt","\"",",","\"","source","\"",",","\"",".","\"",",","\"","eval","\"","]",")"]},"context":{"before":"cbc4fe4b2a752a0e","after":"219695776e9a8ca2"}},"payload":{"text":"First words a line run statement by statement would mean something else with: compound commands (their bodies span\nstatements), and builtins that act on the line's shell itself (`exit` would end only its statement).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:23.546Z","updatedAt":"2026-11-22T18:07:23.546Z"}
{"id":"761a9f20-360b-4513-a941-26f756130c77","kind":"note","ref":{"span":"789317a61bd62b86","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"788abab9d6c995c02ec6087bf68594792127867f","start":1337,"end":1874},"shape":{"type":"ExportDeclaration","atoms":["export","async","function","execInSession","(","session",":","BashSession",",","state",":","SessionState",",","input",":","string",",","signal","?",":","AbortSignal",")",":","Promise","<","{","\"","stdout","\"",":","string",";","\"","stderr","\"",":","string",";","\"","exitCode","\"",":","number","}",">","{","const","status","=","state",".","status","===","undefined","||","state",".","status","===","0","?","\"","","\"",":","`","(exit ","${","state",".","status","}",")\\n","\\","n","`",";","const","result","=","adoptResult","(","state",",","await","session",".","exec","(","status","+","input","+","PROBE",",","{","\"","cwd","\"",":","state",".","cwd",",","\"","env","\"",":","{","...","state",".","env",",","\"","PWD","\"",":","state",".","cwd","}",",","...","signal","===","undefined","?","{","}",":","{","\"","signal","\"",":","signal","}","}",")",")",";","state",".","status","=","result",".","exitCode",";","return","result",";","}"]},"context":{"before":"3ea1302820c4fb55","after":"ec03e5b4b550740a"}},"payload":{"text":"Run `input` in the session `state` (updated in place: cwd from the probe, env from the result) and return its\noutput (the probe stripped) and exit code.\n\n`PWD` is seeded from the session's cwd on every run: just-bash's `$PWD` comes from the env it's given, which beats\nthe `cwd` option — and an interrupted run (Ctrl-C) returns just-bash's DEFAULT env (`PWD=/home/user`), not the\nsession's, without ever reaching the probe. Adopting that env as is would send the next command's probe, and so the\nprompt, to `/home/user`. (An interrupted run keeps the cwd it started in: its own `cd`s never reach us.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:36.839Z","updatedAt":"2026-11-22T18:07:36.839Z"}
{"id":"7a100e30-f34c-4309-8ea6-023b64761b37","kind":"note","ref":{"span":"c5d0c8c55239e8df","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"6b4029ccb7a2166955a4e838e38009ddde61ba0f","start":2154,"end":2251},"shape":{"type":"VariableDeclaration","atoms":["const","status","=","state",".","status","===","undefined","||","state",".","status","===","0","?","\"","","\"",":","`","(exit ","${","state",".","status","}",")\\n","\\","n","`"]},"context":{"before":"d31c414914844915","after":"ea729a4540325d5c"}},"payload":{"text":"(each exec is a shell of its own: the last statement's status is said again, so `node x; echo $?` says node's)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:33.169Z","updatedAt":"2026-11-22T18:07:33.169Z"}
{"id":"938e0c56-3f6a-4432-a5ca-26ddedbbc35f","kind":"note","ref":{"span":"b486d8b3912a6340","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"7f5625d14d6138fe9c15a43245afa02519e7e1c1","start":5729,"end":6043},"shape":{"type":"FunctionDeclaration","atoms":["function","runsWhole","(","input",":","string",",","index",":","number",")",":","boolean","{","const","character","=","input","[","index","]",";","const","next","=","input","[","index","+","1","]",";","return","\"","(){}`","\"",".","includes","(","character",")","||","(","character","===","\"","<","\"","&&","next","===","\"","<","\"",")","||","(","character","===","\"","&","\"","&&","next","!==","\"","&","\"","&&","input","[","index","-","1","]","!==","\"","&","\"","&&","input","[","index","-","1","]","!==","\"",">","\"","&&","next","!==","\"",">","\"",")",";","}"]},"context":{"before":"219695776e9a8ca2","after":"f1dbc390f0044ae4"}},"payload":{"text":"Whether what's at `index` would mean something else run statement by statement: a subshell, a group, a command\nsubstitution, a here-document, a background job.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:19.947Z","updatedAt":"2026-11-22T18:07:19.947Z"}
{"id":"b9d8ef15-880a-4d49-abf9-37dc59ef1936","kind":"note","ref":{"span":"cbc4fe4b2a752a0e","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"d82315bd3b31d54b3a4864a05abfadf4a18c3802","start":3871,"end":4684},"shape":{"type":"ExportDeclaration","atoms":["export","function","outputCaptured","(","statement",":","string",")",":","boolean","{","let","quote",":","\"","'","\"","|","\"","\\","\\\"","\"","\"","|","undefined",";","for","(","let","index","=","0",";","index","<","statement",".","length",";","index","+=","1",")","{","const","character","=","statement","[","index","]",";","const","before","=","statement","[","index","-","1","]",";","if","(","quote","!==","undefined",")","{","if","(","character","===","\"","\\","\\\\","\\","\"","&&","quote","===","\"","\\","\\\"","\"","\"",")","{","index","+=","1",";","}","else","if","(","character","===","quote",")","{","quote","=","undefined",";","}","}","else","if","(","character","===","\"","\\","\\\\","\\","\"",")","{","index","+=","1",";","}","else","if","(","character","===","\"","'","\"","||","character","===","\"","\\","\\\"","\"","\"",")","{","quote","=","character",";","}","else","if","(","character","===","\"","|","\"","&&","statement","[","index","+","1","]","!==","\"","|","\"","&&","before","!==","\"","|","\"",")","{","return","true",";","}","else","if","(","character","===","\"",">","\"","&&","before","!==","\"",">","\"","&&","(","before","===","undefined","||","!","/","\\d","/","u",".","test","(","before",")","||","before","===","\"","1","\"",")","&&","statement","[","index","+","1","]","!==","\"","&","\"",")","{","return","true",";","}","}","return","false",";","}"]},"context":{"before":"858178e077e09a02","after":"7fe0972c2fbc9ab1"}},"payload":{"text":"Whether `statement`'s output goes somewhere other than the terminal: into a pipe (`| tail`) or a file (`> out.txt`,\n`&> log`), outside quotes. A streaming command's output there is handed back through the shell, as any command's,\nrather than written live — or `node x 2>&1 | tail` gives `tail` nothing, and its error goes nowhere to be seen.\n`2> err.txt` and `2>&1` alone move only stderr, so the output still goes to the terminal.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:27.400Z","updatedAt":"2026-11-22T18:07:27.400Z"}
{"id":"db060a7b-43b0-4950-b51d-f489d46481e8","kind":"note","ref":{"span":"34795322c87ed988","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"e071666ae2c5f3fb33e017e1ffe26e2625f39105","start":953,"end":1027},"shape":{"type":"VariableDeclaration","atoms":["const","PROBE","=","`","\\","\\n__jbrc=$?\\nprintf '","n","\\","n","${","RS","}","%s","${","RS","}","%s","${","RS","}","' \"$PWD\" \"$__jbrc\"","`"]},"context":{"before":"fad9731091df9d08","after":"3ea1302820c4fb55"}},"payload":{"text":"Appended to every command: capture the user command's exit code, then emit `<RS>cwd<RS>rc<RS>` so we can read\nthe working directory back (a `cd` has no other way to reach us) and the real exit code (printf would clobber $?).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:38.729Z","updatedAt":"2026-11-22T18:07:38.729Z"}
{"id":"de2c4d86-a8b6-407e-8a4c-e059bf087540","kind":"note","ref":{"span":"858178e077e09a02","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"ae8f363e1401db072e7a8a4193e4871d4c3696c0","start":3366,"end":3519},"shape":{"type":"FunctionDeclaration","atoms":["function","namesStreaming","(","input",":","string",",","streaming",":","ReadonlySet","<","string",">",")",":","boolean","{","return","input",".","split","(","/","[\\s;&|]+","/","u",")",".","some","(","(","word",")","=>","streaming",".","has","(","word",")",")",";","}"]},"context":{"before":"ec03e5b4b550740a","after":"cbc4fe4b2a752a0e"}},"payload":{"text":"Whether `input` names one of the `streaming` commands — those that write their output live, to the terminal as they\nrun, rather than into just-bash's stdout, which it hands back only when the whole line's done: in a line with one,\nwhat the line printed before it would come after. (Which commands stream is the catalog's: catalog.ts.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:29.199Z","updatedAt":"2026-11-22T18:07:29.199Z"}
{"id":"f159e1ea-2b5d-469c-aab3-2064bcaf8679","kind":"note","ref":{"span":"c2b0d11cd3b88c3c","key":"bablr1","file":"packages/editor/workbench/terminal/session.ts","baseline":{"blob":"42049b75bbd4c2206f4464861251cfedd90ccf70","start":3129,"end":3246},"shape":{"type":"Return","atoms":["return","{","\"","stdout","\"",":","stdout",",","\"","stderr","\"",":","result",".","stderr",",","\"","exitCode","\"",":","match","===","null","?","result",".","exitCode",":","Number","(","match","[","2","]",")","}"]},"context":{"before":"c358cb1e0d6c1322","after":"858178e077e09a02"}},"payload":{"text":"The command's own exit code, from the probe (the result's is the probe's printf); an interrupted run's, as is.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T18:07:31.282Z","updatedAt":"2026-11-22T18:07:31.282Z"}
