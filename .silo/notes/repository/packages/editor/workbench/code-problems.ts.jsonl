{"id":"9773dca5-2b90-4973-92a9-b461d4764d1b","kind":"note","ref":{"span":"278d7da852fa0da4","key":"bablr1","file":"packages/editor/workbench/code-problems.ts","baseline":{"blob":"01893f6fd829a179d89b5592b191e29c32d2b00b","start":2781,"end":3533},"shape":{"type":"ExportDeclaration","atoms":["export","function","problemsDelta","(","head",":","Problem","[]",",","now",":","Problem","[]",")",":","{","\"","added","\"",":","Problem","[]",";","\"","cleared","\"",":","Problem","[]",";","\"","unchanged","\"",":","number","}","{","const","key","=","(","problem",":","Problem",")",":","string","=>","JSON",".","stringify","(","[","problem",".","file",",","problem",".","source",",","problem",".","code",",","problem",".","message","]",")",";","const","before","=","new","Map","<","string",",","Problem","[]",">","(",")",";","for","(","const","problem","of","head",")","{","before",".","set","(","key","(","problem",")",",","[","...","before",".","get","(","key","(","problem",")",")","??","[","]",",","problem","]",")",";","}","const","added",":","Problem","[]","=","[","]",";","let","unchanged","=","0",";","for","(","const","problem","of","now",")","{","const","same","=","before",".","get","(","key","(","problem",")",")",";","if","(","same","!==","undefined","&&","same",".","length",">","0",")","{","same",".","shift","(",")",";","unchanged","+=","1",";","}","else","{","added",".","push","(","problem",")",";","}","}","return","{","\"","added","\"",":","added",",","\"","cleared","\"",":","[","...","before",".","values","(",")","]",".","flat","(",")",",","\"","unchanged","\"",":","unchanged","}",";","}"]},"context":{"before":"63eafe2648c2e175","after":"0b98fcf784f2b631"}},"payload":{"text":"The problems `now` has that `head` hasn't (added), and those `head` has that `now` hasn't (cleared), as multisets: a\nproblem is the same one when its file, source, code and message are.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:16:53.147Z","updatedAt":"2026-11-22T17:16:53.1