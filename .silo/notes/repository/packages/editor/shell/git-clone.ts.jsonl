await","walk","(","dir",",","\"","","\"",")",";","return","{","\"","branch","\"",":","(","await","currentBranch","(","{","\"","fs","\"",":","fs",",","\"","dir","\"",":","dir","}",")",")","||","\"","main","\"",",","\"","files","\"",":","files","}",";","}","finally","{","fs",".","umount","(","MOUNT",")",";","}","}"]},"context":{"before":"eb93b84bc6f8adbc"}},"payload":{"text":"Shallow-clone `owner/repo` into memory and return its files, `.git` included: through the API's proxy when signed in\n(any repo the sign-in can see), through the public proxy when not (public repos only).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:55:48.107Z","updatedAt":"2026-11-22T17:55:48.107Z"}
{"id":"89f50eb5-1e90-498d-bc54-47c6191acb04","kind":"note","ref":{"span":"f9736950a1e93af6","key":"bablr1","file":"packages/editor/shell/git-clone.ts","baseline":{"blob":"f3c9fcec311655fa89bac9addef70c43ae4b1bf3","start":175,"end":211},"shape":{"type":"ImportDeclaration","atoms":["import","{","Buffer","}","from","\"","node:buffer","\""]},"context":{"after":"68fc2d83d09e6162"}},"payload":{"text":"Load a GitHub repo by CLONING it — isomorphic-git, shallow (depth 1, one branch) — rather than fetching its blobs one\nrequest at a time through the API (230 files took 2.5 minutes behind fido's 100-a-minute limiter). One pack, so a\nrepo loads in seconds.\n\nA browser can't reach github.com's git endpoints directly (they send no CORS headers). Signed in, the clone goes through\nthe API's proxy (packages/api/src/proxy.ts), every request with our DPoP-bound token: GitHub's token is added there and\nnever reaches the browser. Signed out, a public repo clones through isomorphic-git's public proxy,\ncors.isomorphic-git.org, with no credential at all.\n\nThe clone lands in memory, in a zen-fs mount of its own in the SHELL's realm (never the workspace's FS — that's the\napp's: the token stays here), and ALL of it is returned — its working tree and its `.git` — for the shell to publish\nto the app as a repo load always has. The workspace becomes the clone, history and all: the editor's source control,\nchanges and edit history read a real repo, its HEAD the commit cloned.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:55:53.577Z","updatedAt":"2026-11-22T17:55:53.577Z"}
{"id":"e8718001-2330-4b59-a134-bce390f96388","kind":"note","ref":{"span":"60ace57c81ad056a","key":"bablr1","file":"packages/editor/shell/git-clone.ts","baseline":{"blob":"65cd53d35981518d26a61104b90a1dd17a1e7cae","start":1659,"end":1726},"shape":{"type":"AssignmentExpression","atoms":["(","globalThis","as","unknown","as","{","\"","Buffer","\"","?",":","unknown","}",")",".","Buffer","??=","Buffer"]},"context":{"before":"35cd615026f0eca5","after":"3b541601ee4acfc2"}},"payload":{"text":"isomorphic-git reads the `Buffer` global (a Node-ism); see git-engine.ts.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:55:51.774Z","updatedAt":"2026-11-22T17:55:51.774Z"}
