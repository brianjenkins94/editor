{"id":"39c36ac5-7fb7-497a-b842-aec1c0330bec","kind":"note","ref":{"span":"2e2f2cce6274ff65","key":"bablr1","file":"packages/editor/shell/address.ts","baseline":{"blob":"713d1f973281f1bf9d4e133897070c26186bd137","start":1598,"end":1931},"shape":{"type":"ExportDeclaration","atoms":["export","function","showRepo","(","repo",":","{","\"","owner","\"",":","string",";","\"","repo","\"",":","string","}","|","undefined",")",":","void","{","const","url","=","(","repo","===","undefined","?","site","(",")",":","`","","${","site","(",")","}","env/","${","encodeURIComponent","(","repo",".","owner",")","}","/","${","encodeURIComponent","(","repo",".","repo",")","}","","`",")","+","location",".","search","+","location",".","hash",";","if","(","url","!==","location",".","href",")","{","history",".","replaceState","(","history",".","state",",","\"","","\"",",","url",")",";","}","}"]},"context":{"before":"9f37737e234181aa"}},"payload":{"text":"Show the repo the workspace holds in the address bar (or, with none, the root), without a navigation or a history entry.\nThe query (`?debug`) and the fragment stay.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:56:33.373Z","updatedAt":"2026-11-22T17:56:33.373Z"}
{"id":"6b2515c8-0ae0-4fd8-b250-7fcef0dd2259","kind":"note","ref":{"span":"25a812b60177d0bf","key":"bablr1","file":"packages/editor/shell/address.ts","baseline":{"blob":"179d347cd92fa3901c4132e2afede9d7d64ea9d8","start":967,"end":1036},"shape":{"type":"ExportDeclaration","atoms":["export","const","site","=","(",")",":","string","=>","new","URL","(","\"",".","\"",",","document",".","baseURI",")",".","href"]},"context":{"before":"9f110a4f8a63f734","after":"9f37737e234181aa"}},"payload":{"text":"The site's root: where index.html is, with no query or fragment, whatever path this page is at.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:56:33.780Z","updatedAt":"2026-11-22T17:56:33.780Z"}
{"id":"8e3e0bed-e9bb-4f44-9325-e4223df59466","kind":"note","ref":{"span":"546abc275c284ab4","key":"bablr1","file":"packages/editor/shell/address.ts","baseline":{"blob":"340f84f52fafaf3e843b38ebf39584c4a29f1d7c","start":370,"end":514},"shape":{"type":"ExportDeclaration","atoms":["export","const","PRODUCTION","=","{","\"","site","\"",":","\"","https://editor.unusuallygood.dev","\"",",","\"","api","\"",":","\"","https://api.unusuallygood.dev","\"",",","\"","app","\"",":","\"","unusually-good-editor","\"","}"]},"context":{"after":"9f110a4f8a63f734"}},"payload":{"text":"The production site, its API, and its GitHub App (packages/api/README.md, A7). The build is one for every host, so what it\ntalks to is decided by host: production's on the production site, dev's everywhere else (Pages, localhost).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:56:35.168Z","updatedAt":"2026-11-22T17:56:35.168Z"}
{"id":"a9a014df-0552-49e2-bbd9-9b6e31bd5955","kind":"note","ref":{"span":"546abc275c284ab4","key":"bablr1","file":"packages/editor/shell/address.ts","baseline":{"blob":"e48548cd95b04080173f5d7225124c385579dd98","start":1,"end":145},"shape":{"type":"ExportDeclaration","atoms":["export","const","PRODUCTION","=","{","\"","site","\"",":","\"","https://editor.unusuallygood.dev","\"",",","\"","api","\"",":","\"","https://api.unusuallygood.dev","\"",",","\"","app","\"",":","\"","unusually-good-editor","\"","}"]},"context":{"after":"9f110a4f8a63f734"}},"payload":{"text":"The editor's addresses: the site's root, and `env/<owner>/<repo>` under it — the editor opened to that GitHub repo. The\nhost serves the editor's page at every `env/` path (the `_redirects` rewrite build/static-host.ts writes, Pages' 404.html), and\nindex.html puts a `<base>` at the root there, so the page and its files resolve as they do at the root.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:56:35.574Z","updatedAt":"2026-11-22T17:56:35.574Z"}
{"id":"df603d1b-31b6-471b-90ef-4259b4fe3305","kind":"note","ref":{"span":"9f110a4f8a63f734","key":"bablr1","file":"packages/editor/shell/address.ts","baseline":{"blob":"3ad2684d057252f7d1adb5541461b76e4638f3b6","start":762,"end":852},"shape":{"type":"ExportDeclaration","atoms":["export","const","isProduction","=","(",")",":","boolean","=>","globalThis",".","location","?.","origin","===","PRODUCTION",".","site"]},"context":{"before":"546abc275c284ab4","after":"25a812b60177d0bf"}},"payload":{"text":"`globalThis.`: the tests import the shell's GitHub modules in Node, where there's no location (and so, dev).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:56:34.757Z","updatedAt":"2026-11-22T17:56:34.757Z"}
