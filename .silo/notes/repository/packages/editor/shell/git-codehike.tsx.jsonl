{"id":"f2108d69-0db3-49fd-8feb-7e2672cab6b6","kind":"note","ref":{"span":"9d6c5e860ca42987","key":"bablr1","file":"packages/editor/shell/git-codehike.tsx","baseline":{"blob":"8462c1ea7e55e2384c68f7e7b5f0bc06ba8a2002","start":17968,"end":18011},"shape":{"type":"VariableDeclaration","atoms":["let","currentHighlight",":","HighlightRange","=","null"]},"context":{"before":"389158184e249604","after":"26d8ace1b93f1c0a"}},"payload":{"text":"A tiny external store so the changes-pane chunk list (a different surface) can drive the open diff's highlight on\nhover, without prop-drilling through the React root. One diff is open at a time, so a singleton is enough.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:52:05.919Z","updatedAt":"2026-11-22T17:52:05.919Z"}
