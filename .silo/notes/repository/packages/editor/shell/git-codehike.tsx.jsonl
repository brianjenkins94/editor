{"id":"c8ef0795-ecd0-4a73-be48-8ba65a572d06","kind":"note","ref":{"span":"97ab580345279505","key":"bablr1","file":"packages/editor/shell/git-codehike.tsx","baseline":{"blob":"17531a7ab1757e3fca8e7849ca91460a52563a1a","start":14435,"end":14511},"shape":{"type":"VariableDeclaration","atoms":["const","indent","=","typeof","props",".","indentation","===","\"","number","\"","?","props",".","indentation",":","0"]},"context":{"before":"a73365814c580d0a","after":"6ce5a270e01f7f51"}},"payload":{"text":"Word wrap that hangs at the line's own indent level (codehike's recipe): shift the whole line right by\nits indentation, then pull the first row back by the same amount with a negative text-indent — so the\nfirst row's leading whitespace still lands where it should while every WRAPPED row hangs under the code.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:52:45.508Z","updatedAt":"2026-11-22T17:52:45.508Z"}
{"id":"cd480ed5-230d-497c-aa33-d72003ef4287","kind":"note","ref":{"span":"7b56b658b2579a93","key":"bablr1","file":"packages/editor/shell/git-codehike.tsx","baseline":{"blob":"7f5643ce88be8eca1b1c4bccb2c82bcc4961ef9a","start":3552,"end":3631},"shape":{"type":"VariableDeclaration","atoms":["const","SHIKI_THEME","=","{","\"","light","\"",":","\"","github-light","\"",",","\"","dark","\"",":","\"","github-dark","\"","}","as","const"]},"context":{"before":"1a06bb742137c950","after":"2d7a7c32931b87af"}},"payload":{"text":"The shiki theme used per mode — follows the app's OS-driven light/dark scheme (git-panel passes the mode).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:54:30.094Z","updatedAt":"2026-11-22T17:54:30.094Z"}
