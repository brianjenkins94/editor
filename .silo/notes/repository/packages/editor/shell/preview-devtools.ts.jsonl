{"id":"0bc315a8-f1b5-45de-8d28-002b090b8ea1","kind":"note","ref":{"span":"cc65cd2ccd5b4289","key":"bablr1","file":"packages/editor/shell/preview-devtools.ts","baseline":{"blob":"9122785a40806f7dade67c578f39ebaf2a8bb041","start":6582,"end":7365},"shape":{"type":"StringContent","atoms":["<!DOCTYPE html>\n<html lang=\"en\">\n<meta charset=\"utf-8\">\n<title>DevTools</title>\n<style>@media (prefers-color-scheme: dark) { body { background-color: rgb(41 42 45); } }</style>\n<meta name=\"referrer\" content=\"no-referrer\">\n<script>\nfor (const name of [\"localStorage\", \"sessionStorage\"]) {\n\tconst items = new Map();\n\tconst storage = {\n\t\tget length() { return items.size; },\n\t\tkey: (index) => [...items.keys()][index] ?? null,\n\t\tgetItem: (key) => (items.has(String(key)) ? items.get(String(key)) : null),\n\t\tsetItem: (key, value) => { items.set(String(key), String(value)); },\n\t\tremoveItem: (key) => { items.delete(String(key)); },\n\t\tclear: () => { items.clear(); }\n\t};\n\tObject.defineProperty(window, name, { value: storage, configurable: true });\n}\n</script>\n<script type=\"module\" src=\""]},"context":{"before":"773d52e5a45ef193#0","after":"416fc2bc515df39e"}},"payload":{"text":"Sandboxed (an opaque origin), web storage throws on access: DevTools keeps its settings there, so give it memory.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:45:15.108Z","updatedAt":"2026-11-22T17:45:15.108Z"}
