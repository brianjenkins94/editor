{"id":"ff7c4ad7-b58f-4c81-ae17-9d1d1496dc6e","kind":"note","ref":{"span":"780f4cd31b9d76f9","key":"bablr1","file":"packages/editor/shell/session.ts","baseline":{"blob":"0be9b2759bcd8b7535359bc6c609bc9db8b36f0d","start":2544,"end":2581},"shape":{"type":"ExportDeclaration","atoms":["export","const","dpopFetch","=","client",".","fetch"]},"context":{"before":"1934042d146e75cd","after":"48a529b3d757bad7"}},"payload":{"text":"A `fetch` for the API: our token and a proof on every request, refreshed when stale (util/auth/client).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:40:12.470Z","updatedAt":"2026-11-22T17:40:12.470Z"}
