{"id":"05fa00d9-69a8-4d39-a5a4-1aa0d0031e95","kind":"note","ref":{"span":"000b735308d3d610","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"f5ccb4efdb1a16f6ff775591e6dad4b3300d6e66","start":1401,"end":1494},"shape":{"type":"If","atoms":["if","(","!","globalThis",".","isSecureContext","||","navigator",".","serviceWorker","===","undefined",")","{","return","true",";","}"]},"context":{"before":"7082ab9c29017036","after":"4f32515526a057ad"}},"payload":{"text":"Boot now if we can't isolate at all (no SW/secure context — a dev server may still supply headers).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:19.161Z","updatedAt":"2026-11-22T17:03:19.161Z"}
{"id":"1a0569b7-0aaf-4c5c-b56f-4621d5203f0f","kind":"note","ref":{"span":"97d25c2e4e211308","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"6f5db3ef9ceeec6702f335b32aa3b7b572864ed6","start":3324,"end":3353},"shape":{"type":"MemberExpression","atoms":["registration",".","addEventListener"]},"context":{"before":"ce9c0d20284ccafe","after":"573712dd47f6eddb"}},"payload":{"text":"Not isolated (static host): reload once the worker controls the page so this load gains isolation.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:17.231Z","updatedAt":"2026-11-22T17:03:17.231Z"}
{"id":"20de8bd6-7000-4d1b-bece-c3b55e977268","kind":"note","ref":{"span":"ce9c0d20284ccafe","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"f77a99a80fe4e437526571f1e60ebcac2b13c54f","start":3061,"end":3213},"shape":{"type":"If","atoms":["if","(","switching",")","{","navigator",".","serviceWorker",".","addEventListener","(","\"","controllerchange","\"",",","(",")","=>","{","location",".","reload","(",")",";","}",",","{","\"","once","\"",":","true","}",")",";","return",";","}"]},"context":{"before":"6171c141c2bbe793","after":"b2fcc739f31d28f9"}},"payload":{"text":"The require-corp worker replaces this one (it skips waiting and claims the page): reload once it has.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:17.745Z","updatedAt":"2026-11-22T17:03:17.745Z"}
{"id":"37b1e53b-7552-4071-91ba-cd30c03eae33","kind":"note","ref":{"span":"b27c26df88cf40cd","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"3315e88564d59d24dbc2a00436267c6125e0fe9c","start":2101,"end":2243},"shape":{"type":"MemberExpression","atoms":["navigator",".","serviceWorker",".","register","(","base","+","\"","coi-serviceworker.js","\"","+","(","strict","||","switching","?","\"","?coep=require-corp","\"",":","\"","","\"",")",",","{","\"","type","\"",":","\"","module","\"","}",")",".","then"]},"context":{"before":"a31c2759929541cf","after":"2028fbdca2a27deb"}},"payload":{"text":"Register the service worker whenever we can. In PRODUCTION it PROVIDES isolation (a static host can't\nset COOP/COEP headers, so the worker stamps them). In DEV the vite server already sets those headers,\nbut we still register the worker so its same-origin node_modules resolver (CDN fold-in for go-to-def /\ntype acquisition; see coi-serviceworker.js) and dev-server bridge are active. Registration can fail\n(e.g. an embedded browser that blocks service workers) — that's harmless when headers already isolate.\n{type:module}: the SW is now a bundled ES module (it imports @brianjenkins94/hub — see sw.config.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:18.206Z","updatedAt":"2026-11-22T17:03:18.206Z"}
{"id":"3f4b781f-e29e-4a38-9a57-8a608b1b6195","kind":"note","ref":{"span":"f68b557d88aad0d7","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"82237a3e9a8ff1111d88937f5e568bf7cacf582c","start":1,"end":1513},"shape":{"type":"ExportDeclaration","atoms":["export","function","ensureCrossOriginIsolated","(",")",":","boolean","{","const","isolated","=","globalThis",".","crossOriginIsolated",";","if","(","!","globalThis",".","isSecureContext","||","navigator",".","serviceWorker","===","undefined",")","{","return","true",";","}","const","base","=","(","import",".","meta","as","unknown","as","{","\"","env","\"","?",":","Record","<","string",",","string","|","undefined",">","}",")",".","env","?.","BASE_URL","??","\"","/","\"",";","const","{","controller","}","=","navigator",".","serviceWorker",";","const","strict","=","controller","?.","scriptURL",".","includes","(","\"","coep=require-corp","\"",")","===","true",";","const","switching","=","!","isolated","&&","controller","!==","null","&&","!","strict",";","const","exhausted","=","!","isolated","&&","controller","!==","null","&&","strict",";","navigator",".","serviceWorker",".","register","(","base","+","\"","coi-serviceworker.js","\"","+","(","strict","||","switching","?","\"","?coep=require-corp","\"",":","\"","","\"",")",",","{","\"","type","\"",":","\"","module","\"","}",")",".","then","(","(","registration",")","=>","{","if","(","isolated","||","exhausted",")","{","return",";","}","if","(","switching",")","{","navigator",".","serviceWorker",".","addEventListener","(","\"","controllerchange","\"",",","(",")","=>","{","location",".","reload","(",")",";","}",",","{","\"","once","\"",":","true","}",")",";","return",";","}","registration",".","addEventListener","(","\"","updatefound","\"",",","(",")","=>","{","location",".","reload","(",")",";","}",")",";","if","(","registration",".","active","!==","null","&&","navigator",".","serviceWorker",".","controller","===","null",")","{","location",".","reload","(",")",";","}","}",")",".","catch","(","(","error",":","unknown",")","=>","{","console",".","error","(","\"","[coi] service worker registration failed","\"",",","error",")",";","}",")",";","if","(","exhausted",")","{","console",".","warn","(","\"","[coi] not cross-origin isolated under the service worker: booting without SharedArrayBuffer","\"",")",";","}","return","isolated","||","exhausted",";","}"]},"context":{}},"payload":{"text":"Cross-origin isolation for static hosts. The workbench needs SharedArrayBuffer, which requires the\npage to be crossOriginIsolated (COOP: same-origin + COEP). A dev server sets those headers directly\n(vite.config.ts coi-headers), but GitHub Pages can't — so a service worker (public/coi-serviceworker.js)\nstamps them onto every response instead. On the first, un-isolated load we register the worker and,\nonce it controls the page, reload so this load is isolated; the reloaded page then boots normally.\n\nThe worker stamps COEP `credentialless`, which WebKit (Safari) doesn't take. A load the worker controls that still\nisn't isolated is that case: we register it again as `?coep=require-corp` (the worker then stamps that, which\nSafari does isolate with) and reload once it takes over. The registration remembers the choice, so later loads keep\nit. And a load that isn't isolated even then boots anyway, without SharedArrayBuffer, rather than never.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:20.061Z","updatedAt":"2026-11-22T17:03:20.061Z"}
{"id":"58935a93-db93-4458-ad42-19f005a3751c","kind":"note","ref":{"span":"668cf3e48f5da891","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"8d4db775b990d43c53d3bb22cbc3e43dce4013c6","start":1839,"end":1900},"shape":{"type":"VariableDeclaration","atoms":["const","switching","=","!","isolated","&&","controller","!==","null","&&","!","strict"]},"context":{"before":"a199fb6af58817fe","after":"a31c2759929541cf"}},"payload":{"text":"Controlled but not isolated: credentialless didn't take (WebKit) — try require-corp; if that's what didn't take,\nstop trying.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:18.701Z","updatedAt":"2026-11-22T17:03:18.701Z"}
{"id":"6a860094-d45e-4f5d-87d9-d213866c5994","kind":"note","ref":{"span":"fcdc81a94ff18a25","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"7ae46ca1f012fce1bc9865e4189bf4ae55439c23","start":3860,"end":3888},"shape":{"type":"Return","atoms":["return","isolated","||","exhausted"]},"context":{"before":"199782f9ae0a6932"}},"payload":{"text":"Only a pending reload returns false.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:16.731Z","updatedAt":"2026-11-22T17:03:16.731Z"}
{"id":"bfcfaec5-220f-4929-9401-b06f6313eee6","kind":"note","ref":{"span":"f68b557d88aad0d7","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"6747ba98d09473dac72a7e92fc8cec80a5bf9b72","start":988,"end":2500},"shape":{"type":"ExportDeclaration","atoms":["export","function","ensureCrossOriginIsolated","(",")",":","boolean","{","const","isolated","=","globalThis",".","crossOriginIsolated",";","if","(","!","globalThis",".","isSecureContext","||","navigator",".","serviceWorker","===","undefined",")","{","return","true",";","}","const","base","=","(","import",".","meta","as","unknown","as","{","\"","env","\"","?",":","Record","<","string",",","string","|","undefined",">","}",")",".","env","?.","BASE_URL","??","\"","/","\"",";","const","{","controller","}","=","navigator",".","serviceWorker",";","const","strict","=","controller","?.","scriptURL",".","includes","(","\"","coep=require-corp","\"",")","===","true",";","const","switching","=","!","isolated","&&","controller","!==","null","&&","!","strict",";","const","exhausted","=","!","isolated","&&","controller","!==","null","&&","strict",";","navigator",".","serviceWorker",".","register","(","base","+","\"","coi-serviceworker.js","\"","+","(","strict","||","switching","?","\"","?coep=require-corp","\"",":","\"","","\"",")",",","{","\"","type","\"",":","\"","module","\"","}",")",".","then","(","(","registration",")","=>","{","if","(","isolated","||","exhausted",")","{","return",";","}","if","(","switching",")","{","navigator",".","serviceWorker",".","addEventListener","(","\"","controllerchange","\"",",","(",")","=>","{","location",".","reload","(",")",";","}",",","{","\"","once","\"",":","true","}",")",";","return",";","}","registration",".","addEventListener","(","\"","updatefound","\"",",","(",")","=>","{","location",".","reload","(",")",";","}",")",";","if","(","registration",".","active","!==","null","&&","navigator",".","serviceWorker",".","controller","===","null",")","{","location",".","reload","(",")",";","}","}",")",".","catch","(","(","error",":","unknown",")","=>","{","console",".","error","(","\"","[coi] service worker registration failed","\"",",","error",")",";","}",")",";","if","(","exhausted",")","{","console",".","warn","(","\"","[coi] not cross-origin isolated under the service worker: booting without SharedArrayBuffer","\"",")",";","}","return","isolated","||","exhausted",";","}"]},"context":{}},"payload":{"text":"Whether the caller may boot now. `true` once the page is isolated (dev headers, or a reload has come\nback under the service worker's control), or once isolating has been tried every way; `false` when a reload has\njust been scheduled to gain isolation — the caller should not boot this load.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:03:19.642Z","updatedAt":"2026-11-22T17:03:19.642Z"}
{"id":"f473b6c4-d22c-4848-95a0-85aafba38256","kind":"note","ref":{"span":"02320028df95c1a1#1","key":"bablr1","file":"packages/editor/app/coi.ts","baseline":{"blob":"abb4758c0421c97cf26659ef30bb21c1ce8f53ad","start":766,"end":772},"shape":{"type":"Keyword","atoms":["return"]},"context":{"before":"a6a6015be27e976b#0","after":"ce9c0d20284ccafe"}},"payload":{"text":"isolated already (headers, or the worker), or not possible here: the worker just attaches for the resolver","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T19:03:45.204Z","updatedAt":"2026-11-22T19:03:45.204Z"}
