{"id":"04aa0a51-6b30-4eea-bbe4-44b35bab29b2","kind":"note","ref":{"span":"096024fc3427b0ee","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"12f020a7560ee82822659fbf40143c385a72ebb0","start":3824,"end":3893},"shape":{"type":"PropertySignature","atoms":["\"","openProject","\"",":","(","files",":","ProjectFile","[]",",","openEditors",":","string","[]",")","=>","void",";"]},"context":{"before":"29f056d2f2d35047","after":"06b2e686f430393e"}},"payload":{"text":"Open a project into the ALREADY-BOOTED workbench: write `files` into the workspace and focus `openEditors`.\nWaits for readiness internally, so a call made before boot still lands.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:13.155Z","updatedAt":"2026-11-22T17:04:13.155Z"}
{"id":"0f8f0fdc-e4c8-4b4b-b614-a9610eb4c21f","kind":"note","ref":{"span":"f765793875efd51a","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"1cd0776224b2528976d8dafdb650d57f6f8763ed","start":2652,"end":2678},"shape":{"type":"PropertySignature","atoms":["\"","mountInto","\"","?",":","HTMLElement",";"]},"context":{"before":"d15e14e1223562eb","after":"ccabf8ff7e3dc7e8"}},"payload":{"text":"Where to mount the workbench (the iframe fills this box). Default: document.body.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:19.115Z","updatedAt":"2026-11-22T17:04:19.115Z"}
{"id":"1e1b6ce3-76e6-4ca4-8bbf-f1b5e6588bfd","kind":"note","ref":{"span":"8e3e5ab43f93053e","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"e29bb94462714bcc8c046a84a241040d83393708","start":2074,"end":2099},"shape":{"type":"PropertySignature","atoms":["\"","openEditors","\"","?",":","string","[]",";"]},"context":{"before":"d42e7647ca8a9193","after":"68affc2697ace8c7"}},"payload":{"text":"Files (by path) opened on first layout.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:23.109Z","updatedAt":"2026-11-22T17:04:23.109Z"}
{"id":"2d5c3df4-425c-41c9-ad0d-72be284399c1","kind":"note","ref":{"span":"06b2e686f430393e","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"f640c2ecc4201f54b36e95e839d469d4fa24e56d","start":4088,"end":4160},"shape":{"type":"PropertySignature","atoms":["\"","replaceProject","\"",":","(","files",":","ProjectFile","[]",",","openEditors",":","string","[]",")","=>","void",";"]},"context":{"before":"096024fc3427b0ee","after":"9fbe379c854ce645"}},"payload":{"text":"Like openProject, but CLEARS the workspace first (minus editor scaffolding) — \"workspace = the repo\".","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:12.183Z","updatedAt":"2026-11-22T17:04:12.183Z"}
{"id":"410ae91f-4caa-4c95-9db3-7723f790b4e9","kind":"note","ref":{"span":"ece6cc301317c8b6","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"e32423540dbcb081cf7619c356f18604177c0bf7","start":3255,"end":3345},"shape":{"type":"ExportDeclaration","atoms":["export","interface","ProjectFile","{","\"","path","\"",":","string",";","\"","contents","\"","?",":","string",";","\"","bytes","\"","?",":","Uint8Array","}"]},"context":{"before":"4a4184914413a958","after":"137c7de9d77f1153"}},"payload":{"text":"A file to write when opening a project into the live workbench. Text uses `contents`; binary (loaded from a\nGitHub repo — sprites, etc.) uses `bytes`, which survives the postMessage hop via structured clone.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:15.202Z","updatedAt":"2026-11-22T17:04:15.202Z"}
{"id":"42b37e6f-2cad-4b1d-b357-3ddcce472db1","kind":"note","ref":{"span":"d42e7647ca8a9193","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"320d490fb85d114ecb26be7b956a7a5e919f3a65","start":1910,"end":1963},"shape":{"type":"PropertySignature","atoms":["\"","files","\"","?",":","WorkbenchFile","[]","|","Promise","<","WorkbenchFile","[]",">",";"]},"context":{"before":"25e5f50d84bed413#0","after":"8e3e5ab43f93053e"}},"payload":{"text":"Files to seed the workbench with — awaited only when the workbench asks for them (`workbench.init`).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:24.105Z","updatedAt":"2026-11-22T17:04:24.105Z"}
{"id":"4d8a8ba0-f954-455c-815b-7bf403f2cb0c","kind":"note","ref":{"span":"66eb822eeb6b52be","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"d3d805618807313240d6360911e9ac659f9de49a","start":1734,"end":1758},"shape":{"type":"VariableDeclaration","atoms":["const","PANE_ID","=","\"","editor","\""]},"context":{"before":"4abe5a96d08ecaab","after":"4a4184914413a958"}},"payload":{"text":"The workbench pane's stable id — travels in the iframe URL (`?pane=`) so it survives a popout reload.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:25.069Z","updatedAt":"2026-11-22T17:04:25.069Z"}
{"id":"57972b6b-eb89-4563-9062-fbc1a3e3ec25","kind":"note","ref":{"span":"521e6a5b11a0291e","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"4b7e21ac4d014e09ebcc5bba8641b2525a3f9d60","start":7352,"end":7430},"shape":{"type":"CallExpression","atoms":["paneHub",".","subscribe","(","\"","workbench.online","\"",",","(",")","=>","{","span",".","end","(",")",";","markReady","(",")",";","}",")"]},"context":{"before":"c63363a0f6f6f7cc","after":"0bffcf3f80c2df6f"}},"payload":{"text":"The pane announces it's up (→ whenReady) and streams saves back (→ onSave).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:06.054Z","updatedAt":"2026-11-22T17:04:06.054Z"}
{"id":"65134201-7d3b-4150-b30a-aba24dc515a8","kind":"note","ref":{"span":"edcbc0b6c295489d","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"23c7a3f4fd66b431dcbc7d2a9ae2a796deadfa14","start":3112,"end":3127},"shape":{"type":"PropertySignature","atoms":["\"","tab","\"","?",":","string",";"]},"context":{"before":"ccabf8ff7e3dc7e8","after":"ece6cc301317c8b6"}},"payload":{"text":"This tab's id (see main.tsx), handed to the workbench so its workers address the shared service worker as this tab.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:17.112Z","updatedAt":"2026-11-22T17:04:17.112Z"}
{"id":"6f4a86fe-4668-4699-877e-2ff28933df33","kind":"note","ref":{"span":"a4eb2d27eddc588a","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"97aa1343be79e0e1d7b2bb0e9fa76ac9eafd69ce","start":31,"end":77},"shape":{"type":"ImportDeclaration","atoms":["import","type","{","Hub","}","from","\"","@brianjenkins94/hub","\""]},"context":{"after":"e618932c6b58b061"}},"payload":{"text":"VS Code workbench mounted in an <iframe> that fills the shell's editor space.\n\nThe workbench runs inside an <iframe> (its own document) so monaco taking over `document.body` never\ntouches the host page. The iframe loads `/__vscode__/host.html?pane=editor`, which runs the entry\n(workbench.js). It fills its mount container directly (the shell's middle grid area) — a laid-out box the\niframe can measure at boot. (The old poppable WebAwesome window that hosted it is gone; all movable-window\nchrome — including the preview — now lives in the shell/top frame, so the editor realm carries no WebAwesome.)\n\nHost ⇄ pane talk rides ONE hub link over a retargeting window transport (pane-link.ts): the entry requests\n`workbench.init` (RPC) → we serve the workspace `files`/`openEditors`; it publishes `workbench.save` (→ `onSave`)\nand `workbench.online` when monaco is up (→ whenReady). The transport tracks the pane's live window, so once the\neditor can be popped out these messages reach the popped window with no change here. The host app must only call\nthis once `crossOriginIsolated` is true (SharedArrayBuffer).\n\nEvery pane's structured logs are funnelled back here (logging.ts) so the host console is the one place to\nread what the editor did — including after it's popped into its own tab.\n\nSingleton — monaco-vscode-api is one global workbench; subsequent calls are no-ops.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:26.077Z","updatedAt":"2026-11-22T17:04:26.077Z"}
{"id":"76fa710b-a19e-47a3-9a9c-470a922819f3","kind":"note","ref":{"span":"29f056d2f2d35047","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"7aecc99aa1c991682312d723ffd90557f1c0b7d8","start":3699,"end":3726},"shape":{"type":"PropertySignature","atoms":["\"","whenReady","\"",":","Promise","<","void",">",";"]},"context":{"before":"41092c6c2cb05f03#0","after":"096024fc3427b0ee"}},"payload":{"text":"Resolves once the workbench has actually booted (monaco mounted), for readiness gating.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:14.213Z","updatedAt":"2026-11-22T17:04:14.213Z"}
{"id":"84607134-854b-4340-ad4a-e937ad5536cb","kind":"note","ref":{"span":"ccabf8ff7e3dc7e8","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"0ef5f389e941c3805700e285ee62302c1db4fc68","start":2770,"end":2786},"shape":{"type":"PropertySignature","atoms":["\"","rootHub","\"","?",":","Hub",";"]},"context":{"before":"f765793875efd51a","after":"edcbc0b6c295489d"}},"payload":{"text":"The page's root hub — REQUIRED in practice: the workbench boots over it (we serve `workbench.init`), and the\npane's hub (extension pod + workers) federates into it for spans. The link retargets to the pane's live\nwindow on popout. Typed optional only to keep the options bag ergonomic; omitting it throws.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:18.142Z","updatedAt":"2026-11-22T17:04:18.142Z"}
{"id":"86c80f49-120f-4657-852b-27258eef51f1","kind":"note","ref":{"span":"6bf90dee2fd57aa2","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"570faf188da58eee79a65c9f7da85defdfa39a95","start":5117,"end":5171},"shape":{"type":"VariableDeclaration","atoms":["const","query","=","new","URLSearchParams","(","{","\"","pane","\"",":","PANE_ID","}",")"]},"context":{"before":"661c7c4a1b6fc541","after":"c57172c63c6816a5"}},"payload":{"text":"Explicit host page (not the directory root): monaco's own dist/index.html is the webview pre-page, so\nthe workbench host ships as host.html alongside it. `?pane` gives the entry its identity from the URL,\nso a popped-out reload still announces as the same pane (the pane-link channel; see pane-link.ts). The page's own\n`?extension=`s go along: the extensions from outside the editor it loads (contributed-extensions.ts).","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:10.123Z","updatedAt":"2026-11-22T17:04:10.123Z"}
{"id":"94a54011-cba9-44ac-b7bd-685c2a375f25","kind":"note","ref":{"span":"fa8ac78bde319dda","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"625f5f8f78e71188c58192cf35b689d1bf826085","start":5955,"end":6026},"shape":{"type":"AssignmentExpression","atoms":["iframe",".","style",".","cssText","=","\"","width:100%;height:100%;border:0;display:block;","\""]},"context":{"before":"cdd0a119d71813de","after":"5c7f30cf0c8f03f3"}},"payload":{"text":"The editor IS the shell's middle space: the iframe fills `mountInto` directly, giving it the laid-out box it\nmust measure at boot. (The iframe fill is intrinsic geometry, not chrome — so it's inline style by necessity.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:09.078Z","updatedAt":"2026-11-22T17:04:09.078Z"}
{"id":"95cda2f1-2b9b-4616-b6f0-1a2731f52f67","kind":"note","ref":{"span":"c63363a0f6f6f7cc","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"bc4710d01d1ae94f071ac1deec22adbbd04c46d9","start":7057,"end":7239},"shape":{"type":"CallExpression","atoms":["serve","(","paneHub",",","\"","workbench.init","\"",",","async","(",")","=>","(","{","\"","files","\"",":","await","files",",","\"","openEditors","\"",":","openEditors",",","\"","workspaceFolder","\"",":","workspaceFolder",",","\"","moduleVersions","\"",":","moduleVersions",",","\"","tab","\"",":","tab","}",")",")"]},"context":{"before":"ee2c86f045ba7c11","after":"521e6a5b11a0291e"}},"payload":{"text":"The pane requests its workspace once linked (RPC, retried on its side until interest settles); serve it.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:07.057Z","updatedAt":"2026-11-22T17:04:07.057Z"}
{"id":"97063afd-e3e3-4b1e-b59d-1f29d2404597","kind":"note","ref":{"span":"9545f21b772e01bd","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"28c380cc8819811b50e4fde4dbfccfb40c4bb070","start":6518,"end":6639},"shape":{"type":"If","atoms":["if","(","rootHub","===","undefined",")","{","throw","new","Error","(","\"","createVscodeWindow requires a rootHub — the workbench boots over it","\"",")",";","}"]},"context":{"before":"6e7a17169a723cb6","after":"e2bd667766407d6a"}},"payload":{"text":"ONE hub link carries everything host ⇄ pane — the boot handshake AND the pod/worker span federation — over a\nretargeting window transport that re-pairs to the pane's live window on popout (pane-link.ts). rootHub is\nrequired: the workbench boots from the `workbench.init` we serve below.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:08.094Z","updatedAt":"2026-11-22T17:04:08.094Z"}
{"id":"b39a7be8-ffe1-47c8-b300-c9d1ccff7eac","kind":"note","ref":{"span":"d15e14e1223562eb","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"95ca7596d66b9eb16601a6e74463c9038806ad05","start":2521,"end":2573},"shape":{"type":"PropertySignature","atoms":["\"","onSave","\"","?",":","(","path",":","string",",","contents",":","string",")","=>","void",";"]},"context":{"before":"278f8c9bda8c37ab","after":"f765793875efd51a"}},"payload":{"text":"Called in *this* document when a document is saved in the workbench.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:20.163Z","updatedAt":"2026-11-22T17:04:20.163Z"}
{"id":"dd92dc36-07e9-4c51-8506-1d97e674cd08","kind":"note","ref":{"span":"f91f3fd953264159","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"ca195af42f1dc2fd0b00284648e15cee0b945c6d","start":4536,"end":4596},"shape":{"type":"VariableDeclaration","atoms":["const","span","=","hostLog",".","span","(","\"","editor.app.vscode.editor-window","\"",")"]},"context":{"before":"dd083a39a4c37394","after":"817556525611fcc2"}},"payload":{"text":"(Pane logs now federate onto the hub → the root $sys.log.> collector; no separate window-relay aggregator.)","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:11.095Z","updatedAt":"2026-11-22T17:04:11.095Z"}
{"id":"e89c65b4-08e6-435e-9877-eddf669fb672","kind":"note","ref":{"span":"69ab568b56df0849","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"43204df6de2c5ffce5470a3d0073391a1238e5ca","start":7753,"end":7973},"shape":{"type":"VariableDeclaration","atoms":["const","openProject","=","(","projectFiles",":","ProjectFile","[]",",","entryFiles",":","string","[]",")",":","void","=>","{","void","whenReady",".","then","(","(",")","=>","{","paneHub",".","publish","(","\"","workbench.openProject","\"",",","{","\"","files","\"",":","projectFiles",",","\"","openEditors","\"",":","entryFiles","}",")",";","}",")",";","}"]},"context":{"before":"0bffcf3f80c2df6f","after":"cea9407a3a88f429"}},"payload":{"text":"Open a project into the live workbench: publish the files + entry once it's online (the pane writes them via\nthe vscode FS API and focuses the entry — no reboot). Rides the same hub link, so it follows a popped-out pane.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:05.021Z","updatedAt":"2026-11-22T17:04:05.021Z"}
{"id":"efae36be-de90-4ad8-bb33-34d546dec110","kind":"note","ref":{"span":"68affc2697ace8c7","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"94f6836730bd5c51c66aa4beb84e7d24a9caff4a","start":2149,"end":2176},"shape":{"type":"PropertySignature","atoms":["\"","workspaceFolder","\"","?",":","string",";"]},"context":{"before":"8e3e5ab43f93053e","after":"278f8c9bda8c37ab"}},"payload":{"text":"Workspace folder the files live under (shown as the explorer root, e.g. \"/workspace\").","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:22.138Z","updatedAt":"2026-11-22T17:04:22.138Z"}
{"id":"fd1c89b9-0c9f-4676-be7b-97deea764073","kind":"note","ref":{"span":"278f8c9bda8c37ab","key":"bablr1","file":"packages/editor/app/vscode.tsx","baseline":{"blob":"666f44b0cd8591ebacf44da91f81c50a1257cb97","start":2273,"end":2315},"shape":{"type":"PropertySignature","atoms":["\"","moduleVersions","\"","?",":","Record","<","string",",","string",">",";"]},"context":{"before":"68affc2697ace8c7","after":"d15e14e1223562eb"}},"payload":{"text":"Package version map (name → version). When set, node_modules resolves lazily from the unpkg CDN\noverlay (go-to-definition into deps); type-checking still uses the synchronously-seeded files.","wrote":["Brian Jenkins"]},"author":"local","createdAt":"2026-11-22T17:04:21.132Z","updatedAt":"2026-11-22T17:04:21.132Z"}
